[
  {
    "text": "A turn of the handle looks simple.",
    "start": 1.25,
    "spoken_end": 2.79,
    "end": 3.24,
    "lines": [
      "A turn of the handle looks simple."
    ]
  },
  {
    "text": "Inside Home Soda Machine,",
    "start": 3.65,
    "spoken_end": 4.79,
    "end": 4.97,
    "lines": [
      "Inside Home Soda Machine,"
    ]
  },
  {
    "text": "three things make it possible:",
    "start": 5.01,
    "spoken_end": 5.95,
    "end": 6.67,
    "lines": [
      "three things make it possible:"
    ]
  },
  {
    "text": "pressure, mixing, and cold.",
    "start": 6.71,
    "spoken_end": 8.75,
    "end": 9.2,
    "lines": [
      "pressure, mixing, and cold."
    ]
  },
  {
    "text": "Pull away the enclosure,",
    "start": 10.93,
    "spoken_end": 11.89,
    "end": 11.85,
    "lines": [
      "Pull away the enclosure,"
    ]
  },
  {
    "text": "and this is the cold core.",
    "start": 11.89,
    "spoken_end": 13.27,
    "end": 13.72,
    "lines": [
      "and this is the cold core."
    ]
  },
  {
    "text": "At its center is a stainless steel carbonator:",
    "start": 13.97,
    "spoken_end": 15.81,
    "end": 16.11,
    "lines": [
      "At its center is a",
      "stainless steel carbonator:"
    ]
  },
  {
    "text": "a sealed tank that keeps water",
    "start": 16.15,
    "spoken_end": 17.67,
    "end": 17.63,
    "lines": [
      "a sealed tank that keeps water"
    ]
  },
  {
    "text": "in contact with carbon dioxide.",
    "start": 17.67,
    "spoken_end": 18.95,
    "end": 19.47,
    "lines": [
      "in contact with carbon dioxide."
    ]
  },
  {
    "text": "Carbon dioxide enters through a port at the bottom.",
    "start": 21.39,
    "spoken_end": 23.45,
    "end": 23.9,
    "lines": [
      "Carbon dioxide enters",
      "through a port at the bottom."
    ]
  },
  {
    "text": "While gas is entering,",
    "start": 24.11,
    "spoken_end": 24.95,
    "end": 25.17,
    "lines": [
      "While gas is entering,"
    ]
  },
  {
    "text": "bubbles rise through the water",
    "start": 25.21,
    "spoken_end": 26.21,
    "end": 26.17,
    "lines": [
      "bubbles rise through the water"
    ]
  },
  {
    "text": "and collect in the space above it.",
    "start": 26.21,
    "spoken_end": 27.53,
    "end": 28.01,
    "lines": [
      "and collect in the space above it."
    ]
  },
  {
    "text": "As the pressures balance, gas admission stops.",
    "start": 28.21,
    "spoken_end": 30.27,
    "end": 30.72,
    "lines": [
      "As the pressures balance,",
      "gas admission stops."
    ]
  },
  {
    "text": "Fresh water comes in from the top.",
    "start": 32.62,
    "spoken_end": 34.08,
    "end": 34.53,
    "lines": [
      "Fresh water comes in from the top."
    ]
  },
  {
    "text": "Look closely at the inlet:",
    "start": 34.58,
    "spoken_end": 35.78,
    "end": 35.76,
    "lines": [
      "Look closely at the inlet:"
    ]
  },
  {
    "text": "a tiny, one-sixteenth-inch hole",
    "start": 35.8,
    "spoken_end": 38.5,
    "end": 38.46,
    "lines": [
      "a tiny, one-sixteenth-inch hole"
    ]
  },
  {
    "text": "turns the incoming flow into a narrow jet.",
    "start": 38.5,
    "spoken_end": 40.46,
    "end": 40.91,
    "lines": [
      "turns the incoming flow into a narrow jet."
    ]
  },
  {
    "text": "The stream crosses the carbon dioxide headspace",
    "start": 42.57,
    "spoken_end": 44.45,
    "end": 44.41,
    "lines": [
      "The stream crosses the",
      "carbon dioxide headspace"
    ]
  },
  {
    "text": "and plunges into the water below.",
    "start": 44.45,
    "spoken_end": 45.91,
    "end": 46.36,
    "lines": [
      "and plunges into the water below."
    ]
  },
  {
    "text": "Its impact draws gas into the pool",
    "start": 46.59,
    "spoken_end": 48.45,
    "end": 48.41,
    "lines": [
      "Its impact draws gas into the pool"
    ]
  },
  {
    "text": "and drives circulation.",
    "start": 48.45,
    "spoken_end": 49.41,
    "end": 50.25,
    "lines": [
      "and drives circulation."
    ]
  },
  {
    "text": "Those moving interfaces give carbon dioxide",
    "start": 50.39,
    "spoken_end": 52.59,
    "end": 52.55,
    "lines": [
      "Those moving interfaces",
      "give carbon dioxide"
    ]
  },
  {
    "text": "more opportunities to dissolve.",
    "start": 52.59,
    "spoken_end": 54.03,
    "end": 54.48,
    "lines": [
      "more opportunities to dissolve."
    ]
  },
  {
    "text": "The bubbles are the process you can see.",
    "start": 56.61,
    "spoken_end": 57.97,
    "end": 58.42,
    "lines": [
      "The bubbles are the process you can see."
    ]
  },
  {
    "text": "The carbonation you drink",
    "start": 59.24,
    "spoken_end": 60.08,
    "end": 60.04,
    "lines": [
      "The carbonation you drink"
    ]
  },
  {
    "text": "is gas dissolved in the water.",
    "start": 60.08,
    "spoken_end": 61.38,
    "end": 61.88,
    "lines": [
      "is gas dissolved in the water."
    ]
  },
  {
    "text": "As the level rises, a magnetic float follows it.",
    "start": 63.63,
    "spoken_end": 65.99,
    "end": 66.44,
    "lines": [
      "As the level rises,",
      "a magnetic float follows it."
    ]
  },
  {
    "text": "At the high-level signal, the refill pump stops.",
    "start": 66.63,
    "spoken_end": 68.49,
    "end": 68.94,
    "lines": [
      "At the high-level signal,",
      "the refill pump stops."
    ]
  },
  {
    "text": "Now look outside the tank.",
    "start": 71.02,
    "spoken_end": 71.96,
    "end": 72.82,
    "lines": [
      "Now look outside the tank."
    ]
  },
  {
    "text": "This copper coil carries refrigerant.",
    "start": 72.96,
    "spoken_end": 74.44,
    "end": 74.89,
    "lines": [
      "This copper coil carries refrigerant."
    ]
  },
  {
    "text": "As it evaporates, it absorbs heat",
    "start": 75.31,
    "spoken_end": 77.05,
    "end": 77.01,
    "lines": [
      "As it evaporates, it absorbs heat"
    ]
  },
  {
    "text": "through the coil and the stainless steel wall.",
    "start": 77.05,
    "spoken_end": 78.75,
    "end": 79.2,
    "lines": [
      "through the coil",
      "and the stainless steel wall."
    ]
  },
  {
    "text": "The refrigeration loop carries that heat away.",
    "start": 80.33,
    "spoken_end": 82.05,
    "end": 82.5,
    "lines": [
      "The refrigeration loop",
      "carries that heat away."
    ]
  },
  {
    "text": "Cold water can hold more dissolved carbon dioxide.",
    "start": 84.19,
    "spoken_end": 86.11,
    "end": 86.56,
    "lines": [
      "Cold water can hold",
      "more dissolved carbon dioxide."
    ]
  },
  {
    "text": "Pressure, mixing, and cooling work together,",
    "start": 87.93,
    "spoken_end": 90.11,
    "end": 90.56,
    "lines": [
      "Pressure, mixing, and",
      "cooling work together,"
    ]
  },
  {
    "text": "so the next pour starts with chilled, carbonated water,",
    "start": 90.61,
    "spoken_end": 92.99,
    "end": 92.95,
    "lines": [
      "so the next pour starts with",
      "chilled, carbonated water,"
    ]
  },
  {
    "text": "ready for a separate stream of flavor at the faucet.",
    "start": 92.99,
    "spoken_end": 95.55,
    "end": 96.0,
    "lines": [
      "ready for a separate stream",
      "of flavor at the faucet."
    ]
  },
  {
    "text": "Home Soda Machine.",
    "start": 97.42,
    "spoken_end": 98.02,
    "end": 98.84,
    "lines": [
      "Home Soda Machine."
    ]
  },
  {
    "text": "Cold soda, on tap.",
    "start": 98.88,
    "spoken_end": 99.98,
    "end": 100.68,
    "lines": [
      "Cold soda, on tap."
    ]
  }
]
