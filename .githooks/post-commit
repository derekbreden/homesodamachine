#!/bin/sh
# A SYNC THAT STAGES DURING A PATHSPEC COMMIT LEAVES A GHOST IN THE REAL INDEX.
#
# `git commit -- <paths>` runs against a TEMPORARY index (`GIT_INDEX_FILE` points at
# `.git/next-index-*.lock`). Everything the pre-commit re-derives and stages goes in through
# that one and IS committed — but the real index is never updated, so it keeps the file's
# PRE-COMMIT blob. HEAD moves on, the worktree moves with it, and the index alone stays
# behind. `git status` shows `MM`, and the next bare `git commit` lands that older blob and
# silently undoes what this commit derived.
#
# THE SIGNATURE: the worktree matches HEAD, and the index matches neither. Content somebody
# staged on purpose and is holding for a later commit does NOT look like this — there the
# worktree still differs from HEAD, so it is never touched.
#
# ONE OTHER THING WEARS IT, and that is why the blob is named before it goes: stage a change,
# then edit the file back to what HEAD holds. The worktree matches HEAD, the index keeps the
# staged edit, and this drops it — the index was that edit's only reference. So the hash is
# printed first. The blob is still in the object store until it is collected, and
# `git cat-file -p <hash>` reads it back.
root=$(git rev-parse --show-toplevel) || exit 0
_ghosts=$(git -C "$root" diff --cached --name-only HEAD | while IFS= read -r f; do
  [ -n "$f" ] || continue
  git -C "$root" diff --quiet HEAD -- "$f" 2>/dev/null && printf '%s\n' "$f"
done)
if [ -n "$_ghosts" ]; then
  echo "post-commit: dropped $(printf '%s\n' "$_ghosts" | wc -l | tr -d ' ') stale index entry(ies) this commit left behind." >&2
  printf '%s\n' "$_ghosts" | while IFS= read -r f; do
    _blob=$(git -C "$root" rev-parse ":$f" 2>/dev/null)
    echo "      $f  was $_blob" >&2
    git -C "$root" reset -q HEAD -- "$f" >/dev/null 2>&1
  done
  echo "post-commit:   no file changed. To read one back: git cat-file -p <hash>" >&2
fi

# AND THEN IT GOES. The site deploys on a push — `render.yaml`'s buildFilter names `web/**` and
# the artifact lock — so this hook is the distance between a commit and homesodamachine.com.
#
# `push.py` lands it: a commit whose patch is already on the remote under another hash is
# dropped, anything else is replayed in a detached worktree that shares no index with the
# sessions building here, and a conflict is left alone and named.
#
# IT REPORTS AND DOES NOT HOLD. The commit is already made and this hook's exit status cannot
# unmake it, so a push that does not land says so and leaves the work committed.
_py="$root/tools/cad-venv/bin/python"
[ -x "$_py" ] || _py=python3
"$_py" "$root/tools/push.py" 2>&1 | sed 's/^/post-commit: /' >&2
exit 0
