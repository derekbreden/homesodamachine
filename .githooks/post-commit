#!/bin/sh
# Land this commit and publish completed outputs through the native commands.
root=$(git rev-parse --show-toplevel) || exit 0
[ -n "$HSM_PUSHING" ] && exit 0
[ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ] && exit 0

native_tool() {
  if [ -x "$root/tools/hsm/target/release/$1" ]; then
    printf '%s\n' "$root/tools/hsm/target/release/$1"
  elif [ -x "$HOME/.local/bin/$1" ]; then
    printf '%s\n' "$HOME/.local/bin/$1"
  else
    command -v "$1"
  fi
}

land=$(native_tool hsm-land) || {
  echo 'post-commit: install hsm-land to land this commit on main.' >&2
  exit 0
}
"$land" --root "$root" 2>&1 | sed 's/^/post-commit: /' >&2

mkdir -p "$root/.cache"
if publisher=$(native_tool hsm-publish); then
  nohup "$publisher" --root "$root" >>"$root/.cache/publish-now.log" 2>&1 &
else
  echo 'post-commit: install hsm-publish to publish completed outputs.' >&2
fi
if readings=$(native_tool hsm-build-times); then
  nohup "$readings" --root "$root" >>"$root/.cache/build-times.log" 2>&1 &
fi
exit 0
