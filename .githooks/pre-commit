#!/bin/sh
# What stands between a change and the site, checked on this disk.
#
# THE SITE DEPLOYS WHEN THE LOCK MOVES IN A PUSH — `render.yaml`'s buildFilter names
# `hardware/cad-artifacts.lock.json`, and `pack.py --write` cuts, uploads and pins from any
# machine. So the path a change takes to Derek is: build the changed target here, `--write`,
# push. CI publishes too, and what it is for is catching what that missed while nobody is
# waiting.
#
# TWO FAULTS HOLD A COMMIT, AND THEY ARE THE TWO THAT PATH CANNOT SURVIVE. Everything else is
# reported, because the local build is already the thing that fails on it — in seconds, on this
# disk, with the compiler's own message rather than a gate's paraphrase.
#
# Each gate is keyed to the files that can carry its fault, so a commit to `web/` or a doc runs
# none of them. HSM_SKIP_PRECOMMIT=1 skips them all.
[ -n "$HSM_SKIP_PRECOMMIT" ] && exit 0
root=$(git rev-parse --show-toplevel) || exit 0
py="$root/tools/cad-venv/bin/python"
[ -x "$py" ] || py=python3
staged=$(git diff --cached --name-only --diff-filter=ACM)

# HOLDS: A GRAPH THAT COMES BACK AROUND fails bazel's loading phase, which is before any target
# is built — so the changed target does not build either, and there is nothing to publish.
case "$staged" in
  *tools/bazel/graph.json*|*tools/bazel/gen_build.py*|*BUILD.bazel*)
    "$py" "$root/tools/bazel/gen_build.py" --cycles || exit 1 ;;
esac

# HOLDS: BUILD.bazel DRIFTED FROM ITS GENERATOR builds the rules the file holds and not the ones
# the graph states, and `pack.py --write` uploads what that built. A red CI run is a delay; this
# is the site serving geometry cut by a rule nobody has.
case "$staged" in
  *tools/bazel/selftests.json*|*tools/bazel/graph.json*|*BUILD.bazel*)
    "$py" "$root/tools/bazel/gen_build.py" --check || exit 1 ;;
esac

# REPORTS: a step that imports what it does not hold fails its own action, which is the build
# the author just ran. `--fix` writes the edges in seconds.
case "$staged" in
  *.py*) "$py" "$root/tools/bazel/check_declared_imports.py" || true ;;
esac

# REPORTS: a workflow naming a target the graph does not declare, and a source no `paths:`
# pattern names. Both are faults in how CI publishes; neither reaches a local build or a
# `--write` from this machine.
case "$staged" in
  *BUILD.bazel*|*tools/bazel/graph.json*|*tools/bazel/gen_build.py*|*.github/workflows/*)
    "$py" "$root/tools/bazel/check_ci_targets.py" || true ;;
esac
case "$staged" in
  *tools/bazel/graph.json*|*.github/workflows/publish.yml*)
    "$py" "$root/tools/bazel/check_publish_paths.py" || true ;;
esac

exit 0
