#!/bin/sh
# ONE THING HOLDS A COMMIT HERE, AND IT IS NOT WHETHER ANYTHING IS RED.
#
# A cycle in the build graph fails bazel's LOADING phase, which is before any target is built:
# every one of them fails at once and none of the messages names the pair at fault. Nothing
# ships until it is gone — not the part being worked on, not the assembly, not the site. That
# is the only fault below that stops a commit, and it is decided by walking a dictionary.
#
# EVERYTHING ELSE REPORTS. An undeclared import fails one action and leaves the rest of the
# build standing, so it is named with the command that settles it and the commit goes in.
#
# AND EACH GATE IS KEYED TO WHAT THE COMMIT TOUCHED, so a commit to web/ or a doc pays nothing.
#
# HSM_SKIP_PRECOMMIT=1 skips both.
[ -n "$HSM_SKIP_PRECOMMIT" ] && exit 0
root=$(git rev-parse --show-toplevel) || exit 0
py="$root/tools/cad-venv/bin/python"
[ -x "$py" ] || py=python3
staged=$(git diff --cached --name-only --diff-filter=ACM)

# A GRAPH THAT COMES BACK AROUND. Three files decide the relation and no other can move it:
# `graph.json` is the record a rule's reads come from, `gen_build.py` is what turns a read into
# an edge, and BUILD.bazel is where the result lands.
case "$staged" in
  *tools/bazel/graph.json*|*tools/bazel/gen_build.py*|*BUILD.bazel*)
    "$py" "$root/tools/bazel/gen_build.py" --cycles || exit 1 ;;
esac

# A STEP THAT IMPORTS WHAT IT DOES NOT HOLD finds no module — `ModuleNotFoundError` on a file
# sitting tracked in the tree. This reads the staged `.py` and names every step that reaches it,
# and `--fix` writes those edges without watching a run. It never holds the commit.
case "$staged" in
  *.py*) "$py" "$root/tools/bazel/check_declared_imports.py" || true ;;
esac

exit 0
