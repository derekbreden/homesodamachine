#!/bin/sh
# Commit-time gates + 3D freshness for the PCBA and the enclosure.
#
# Two jobs, in order:
#
#   1. GATES (hard fail — a red check blocks the commit):
#      Each gate is keyed to EXACTLY the files it reads, so a commit pays only for
#      the answers it could have changed. A commit touching no gate's inputs runs no
#      Python at all.
#      - pcba.tsx / esp32-pinout.mmd / bom.md / the two assembly sync drivers
#                                           → check_pinmap.py, the BOM<->pinout<->PCB
#        drift guard (pcba.tsx is canonical; pinout/BOM/sync-drivers are derived and
#        hand-maintained, so they drift).
#      - ledger/bom.md                      → _bom_categories.py --check (every row
#        carries a known category tag) + _bom_totals.py --check (the printed subtotals
#        match the rows under them).
#      - ledger/labor.md                    → _labor_totals.py --check (subtotals, and
#        every estimate on the believable-increment ladder).
#      - ledger/machine-time.md or bom.md   → _machine_time.py --check (print hours are
#        derived from §7's masses, so a printed part moves them).
#      - any staged *.py under hardware/    → check_build_exit.py.
#      - printed-parts/ or its bom.md       → _bom_masses.py --check, which reads §7's
#        masses off the parts' own STEP solids. A part's geometry and its ledger row
#        land together or not at all. ~4 s — the expensive one.
#      - hardware/pcb/pcba/                 → the render scorecard's fab-ready gates
#        (out/pcba.picks.json scorecard.gatesPass), silk-audit.py (label ink on bare
#        copper), part-orientation-audit.py (3D model vs footprint, ~8 s). These read
#        the out/ artifacts of the last render — a red gate means the board being
#        committed is not fab-ready.
#      - hardware/ enclosure                → reported, never gated. A pack that does not
#        close prints its clash count and lands, .step and sidecar intact for the editor
#        to open. Rebuild-and-compare across every generator is `npm --prefix web run
#        build:check`; the enclosure gates' own inject-defect run is `scorecard_selftest.py`.
#      Gates print one ✓ line each on pass and dump their full output on red.
#
#   2. GLB freshness (best-effort — never blocks): render-board.ts deliberately skips
#      the ~14 s CadQuery 3D build so board iteration stays fast, which lets
#      out/pcba.glb drift behind the gerbers during a work session. This hook is the
#      single place that reconciles it: on a board-touching commit whose GLB is behind
#      the gerbers, rebuild it once and stage it — the 3D never lands stale, and
#      nobody waits on it mid-iteration. Any failure here (no cad-venv, board-3d.py
#      error) prints a warning and lets the commit through.

root=$(git rev-parse --show-toplevel) || exit 0
pcba="$root/hardware/pcb/pcba"
py="$root/tools/cad-venv/bin/python"
editions="hardware"

# The board gates and the GLB rebuild below run CadQuery. They take the CAD build lock
# (so a stray rebuild is cleared off the machine) but must not be superseded by one — a
# watcher rebuild landing mid-commit would otherwise fail the commit, and a commit that
# fails for a reason the author never caused is worse than a slow one.
# See hardware/scripts/_run_lock.py.
export HSM_BUILD_SOURCE="pre-commit"
export HSM_BUILD_LOCK_PROTECT=1

touches_board=false
git diff --cached --name-only -- "hardware/pcb/pcba/" | grep -q . && touches_board=true

fail=0

# gate <name> <cmd…> — run a check; one ✓ line on pass, full output + red line on fail.
gate() {
  _name=$1; shift
  if _out=$("$@" 2>&1); then
    echo "pre-commit: $_name ✓" >&2
  else
    echo "$_out" >&2
    echo "pre-commit: GATE RED — $_name (commit blocked)" >&2
    fail=1
  fi
}

# ── 1. Gates ──────────────────────────────────────────────────────────────
# staged <pathspec…> — true when the commit stages anything under these paths.
#
# EVERY GATE IS KEYED TO EXACTLY THE FILES IT READS, plus its own script. A gate
# keyed wider than its inputs charges every unrelated commit for an answer that
# could not have changed; a gate keyed narrower than its inputs silently stops
# running. So when a script grows an input, widen its key here in the same
# breath — the pathspec below IS the claim about what the script reads.
staged() {
  git diff --cached --name-only -- "$@" | grep -q .
}

for hw in $editions; do
  touches_enclosure=false
  git diff --cached --name-only -- "$hw/printed-parts/enclosure/" | grep -q . && touches_enclosure=true
  enc="$root/$hw/printed-parts/enclosure/enclosure-assembly"

  # BOM <-> pinout <-> PCB drift. Reads the board source, the pinout diagram,
  # bom.md, and the two assembly sync drivers — nothing else moves its answer.
  if staged "$hw/pcb/pcba/pcba.tsx" "$hw/wiring/esp32-pinout.mmd" "$hw/ledger/bom.md" \
            "$hw/assembly/_electronics_shelf_sync.py" \
            "$hw/assembly/_firmware_and_commissioning_sync.py" \
            "$hw/scripts/check_pinmap.py"; then
    gate "$hw pin-map drift check" python3 "$root/$hw/scripts/check_pinmap.py"
  fi

  # bom.md's own two gates: every row carries a known category tag, and the
  # printed subtotals match the rows under them. The totals gate exists because
  # they went stale twice inside two days — a row's cost moved and the ledger's
  # own total disagreed with /cost, which sums the rows itself.
  if staged "$hw/ledger/bom.md" "$hw/scripts/_bom_categories.py" "$hw/scripts/_bom_totals.py"; then
    gate "$hw bom category tags" python3 "$root/$hw/scripts/_bom_categories.py" --check
    gate "$hw bom totals" python3 "$root/$hw/scripts/_bom_totals.py" --check
  fi

  # Attended-minute ledger: subtotals summed, and every estimate on the
  # believable-increment ladder.
  if staged "$hw/ledger/labor.md" "$hw/scripts/_labor_totals.py"; then
    gate "$hw labor totals" python3 "$root/$hw/scripts/_labor_totals.py" --check
  fi

  # Machine-hours ledger. Keyed on bom.md too: it reads §7's masses to derive
  # the print hours, so a printed part that changes shape moves this ledger, and
  # a §7 row with no print-rate group has to fail here rather than vanish from
  # the turnaround and throughput figures.
  if staged "$hw/ledger/machine-time.md" "$hw/ledger/bom.md" "$hw/scripts/_machine_time.py"; then
    gate "$hw machine-time totals" python3 "$root/$hw/scripts/_machine_time.py" --check
  fi

  # The fluid-topology charts against the enclosure assembly: every edge gated against the
  # run it names, every length read off the built centreline. Rebuilds the pack to ask,
  # ~45 s. A commit that moves the GEOMETRY under the charts instead of the charts
  # themselves is caught by the mtime warning in the enclosure block below.
  if staged "$hw/topology/" "$hw/topology/_fluid_topology_sync.py"; then
    if [ -x "$py" ]; then
      gate "$hw fluid-topology charts" "$py" "$root/$hw/topology/_fluid_topology_sync.py" --check
    else
      echo "pre-commit: no cad-venv — $hw fluid-topology charts skipped" >&2
    fi
  fi

  # Walks every .py under the edition for `raise SystemExit` in a lock-taking
  # script, so only a staged Python file can change its answer. Pathspec can't
  # express "*.py at any depth" portably — filter the staged list instead.
  if git diff --cached --name-only -- "$hw/" | grep -q '\.py$'; then
    gate "$hw build exit status" python3 "$root/$hw/scripts/check_build_exit.py"
  fi

  touches_printed=false
  git diff --cached --name-only -- "$hw/printed-parts/" "$hw/ledger/bom.md" | grep -q . && touches_printed=true
  if $touches_printed; then
    # bom.md §7 reads its masses off the parts' own solids. A geometry change that
    # lands without carrying its mass leaves the ledger quoting a part that is not
    # the one that ships — so the row and the STEP have to move together. ~4 s.
    if [ -x "$py" ]; then
      gate "$hw bom printed masses" "$py" "$root/$hw/scripts/_bom_masses.py" --check
    else
      echo "pre-commit: no cad-venv — $hw bom printed masses skipped" >&2
    fi
  fi

  if $touches_enclosure; then
    # A red pack prints its clash count and lands.
    if [ -f "$enc/enclosure-assembly.scorecard.json" ]; then
      python3 -c '
import json, sys
try:
    sc = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
pack = next((c for c in sc.get("checks", []) if c.get("id") == "pack-closes"), None)
if pack is not None and pack["status"] != "pass":
    print("pre-commit: " + sys.argv[2] + " enclosure pack does NOT close — " + str(pack["value"])
          + " (committing anyway)", file=sys.stderr)
' "$enc/enclosure-assembly.scorecard.json" "$hw"
    fi

    # A sidecar older than its sources carries a verdict those sources no longer produce.
    for src in "$enc/_contents.py" "$enc/scorecard.py" "$enc/enclosure_assembly.py" \
               "$root/$hw/printed-parts/enclosure/enclosure/enclosure.py"; do
      if [ -f "$src" ] && [ "$src" -nt "$enc/enclosure-assembly.scorecard.json" ]; then
        echo "pre-commit: $hw enclosure scorecard sidecar may be behind $(basename "$src") — rebuild: tools/cad-venv/bin/python enclosure_assembly.py" >&2
        break
      fi
    done

    # Same reading for the charts: they quote lengths off these runs, so a chart older
    # than the geometry is quoting stock the machine no longer cuts.
    mmd="$root/$hw/topology/fluid-topology-manifold.mmd"
    for src in "$enc/_lines.py" "$enc/_contents.py" "$enc/_routing.py"; do
      if [ -f "$src" ] && [ -f "$mmd" ] && [ "$src" -nt "$mmd" ]; then
        echo "pre-commit: $hw fluid-topology charts may be behind $(basename "$src") — resync: tools/cad-venv/bin/python $hw/topology/_fluid_topology_sync.py" >&2
        break
      fi
    done
  fi
done

if $touches_board; then
  gate "scorecard fab-ready gates" python3 -c '
import json, sys
p = sys.argv[1]
try:
    sc = json.load(open(p))["scorecard"]
except Exception as e:
    sys.exit("cannot read the render scorecard in " + p + " (" + repr(e) + ") - run: bun render-board.ts pcba.tsx")
if not sc["gatesPass"]:
    for c in sc["checks"]:
        if c.get("kind") == "gate" and c["status"] != "pass":
            print("  gate red:", c["label"], "-", c["value"], "(target", c["target"] + ")", file=sys.stderr)
    sys.exit("BOARD NOT FAB-READY per the render scorecard")
' "$pcba/out/pcba.picks.json"

  gate "silk-audit" sh -c "cd \"$pcba\" && python3 silk-audit.py"

  if [ -x "$py" ]; then
    gate "part-orientation-audit" sh -c "cd \"$pcba\" && \"$py\" part-orientation-audit.py"
  else
    echo "pre-commit: no cad-venv — part-orientation-audit skipped" >&2
  fi
fi

# ── 2. GLB freshness (only worth doing when the commit will go through) ───
if [ "$fail" -eq 0 ] && $touches_board && [ -f "$pcba/out/pcba.gerbers.zip" ]; then
  if [ ! -f "$pcba/out/pcba.glb" ] || [ "$pcba/out/pcba.gerbers.zip" -nt "$pcba/out/pcba.glb" ]; then
    if [ -x "$py" ]; then
      echo "pre-commit: out/pcba.glb is behind the gerbers — rebuilding the 3D (one-time, ~14 s)…" >&2
      if ( cd "$pcba" && "$py" board-3d.py ) >&2; then
        git -C "$root" add \
          hardware/pcb/pcba/out/pcba.glb \
          hardware/pcb/pcba/out/pcba.top3d.png \
          hardware/pcb/pcba/out/pcba.bottom3d.png
      else
        echo "pre-commit: board-3d failed — committing a possibly-stale GLB (rerun: tools/cad-venv/bin/python board-3d.py)" >&2
      fi
    else
      echo "pre-commit: no cad-venv — out/pcba.glb may be stale (run: tools/cad-venv/bin/python board-3d.py)" >&2
    fi
  fi
fi

exit $fail
