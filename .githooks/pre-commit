#!/bin/sh
# Commit-time checks + 3D freshness for the PCBA and the enclosure.
#
# NOTHING HERE HOLDS A COMMIT. Every check reports and the commit goes in, so the change
# reaches a deploy and can be looked at while what the checks found is still being fixed.
# A red one is a FOLLOW-UP COMMIT's work, named at the tail so it survives the scroll.
#
# Three jobs, in order. Everything here is keyed to EXACTLY the files it reads, so a
# commit pays only for the answers it could have changed; a commit touching none of
# those inputs runs no Python at all.
#
#   1. LEDGER SYNCS (they re-derive, stage, and let the commit carry it):
#      A figure derived from the model is a number that needs copying, not a decision,
#      and the script that spots the drift is the script that copies it. So it does,
#      and the change lands in the commit's own diff instead of in a terminal line
#      telling someone to run the script by hand. In dependency order, because §7's
#      masses price the totals and the totals' §7 feeds the print hours:
#      - printed-parts/ or its bom.md       → _bom_masses.py, which reads §7's masses
#        off the parts' own STEP solids. ~4 s, and it stands in for the --check that
#        cost the same and then asked for this run anyway.
#      - ledger/bom.md                      → _bom_totals.py (section + grand totals).
#      - ledger/labor.md                    → _labor_totals.py (subtotals).
#      - ledger/machine-time.md or bom.md   → _machine_time.py (print hours off §7's
#        masses, turnaround off those hours).
#      Only the file a sync moved is staged, so a commit never sweeps up a neighbour's
#      dirty edit.
#
#   2. CHECKS (they report; the commit goes in either way). What is left after a sync is
#      what no script can settle: a decision a person has to make.
#      - pcba.tsx / esp32-pinout.mmd / bom.md / the two assembly sync drivers
#                                           → check_pinmap.py, the BOM<->pinout<->PCB
#        drift guard (pcba.tsx is canonical; pinout/BOM/sync-drivers are derived and
#        hand-maintained, so they drift, and which one is right is a judgement).
#      - ledger/bom.md                      → _bom_categories.py --check. Which section
#        a new row belongs in has no write mode and never will.
#      - ledger/labor.md                    → _labor_totals.py --check, for the
#        believable-increment ladder: 30 or 45, never 37.
#      - ledger/machine-time.md or bom.md   → _machine_time.py --check, for a §7 row
#        with no print-rate group. GROUP_OF is the decision.
#      - any staged *.py under hardware/    → check_build_exit.py.
#      - web/package.json or its lockfile   → `npm ci --dry-run`, which is what render.yaml
#        runs for real. The lockfile is the record of what the deployed site installs, so
#        the two moving apart is a broken build waiting at the far end of a push.
#      - BUILD.bazel, graph.json, selftests.json, or a staged add or delete
#                                           → gen_build.py --check, which re-derives
#        BUILD.bazel from the traced graph and holds it against the file in the tree.
#      - hardware/pcb/pcba/                 → the render scorecard's fab-ready gates
#        (out/pcba.picks.json scorecard.gatesPass), silk-audit.py (label ink on bare
#        copper), part-orientation-audit.py (3D model vs footprint, ~8 s). These read
#        the out/ artifacts of the last render — a red gate means the board being
#        committed is not fab-ready.
#      - hardware/ enclosure gates          → nothing. The enclosure assembly carries its
#        own gates and runs them itself: hardware/manifold-layout/enclosure_assembly.py
#        prints the scorecard at the tail of every run and writes
#        enclosure-assembly.scorecard.json beside the STEP, so nothing here re-runs them,
#        and a red row rides the card rather than stopping anything.
#      - nothing asks bazel. `bazel build //:everything` and tools/bazel/sync_tree.py say
#        whether the tree carries what its sources make, and they belong wherever somebody
#        wants that answer — not in front of every commit. A red one does not hold a commit
#        anyway, so what a check here buys is a line of output, and what it costs is the
#        wait for whatever holds the workspace lock.
#      Each prints one ✓ line on pass and dumps its full output on red, and the tail
#      lists every red one as the follow-up commit's work.
#
#   3. GLB freshness (best-effort): render-board.ts deliberately skips
#      the ~14 s CadQuery 3D build so board iteration stays fast, which lets
#      out/pcba.glb drift behind the gerbers during a work session. This hook is the
#      single place that reconciles it: on a board-touching commit whose GLB is behind
#      the gerbers, rebuild it once and stage it — the 3D never lands stale, and
#      nobody waits on it mid-iteration. Any failure here (no cad-venv, board-3d.py
#      error) prints a warning and lets the commit through.

root=$(git rev-parse --show-toplevel) || exit 0
pcba="$root/hardware/pcb/pcba"
py="$root/tools/cad-venv/bin/python"
editions="hardware"

# The board gates and the GLB rebuild below run CadQuery. They take the CAD build lock
# (so a stray rebuild is cleared off the machine) but must not be superseded by one — a
# watcher rebuild landing mid-commit would otherwise fail the commit, and a commit that
# fails for a reason the author never caused is worse than a slow one.
# See hardware/scripts/_run_lock.py.
export HSM_BUILD_SOURCE="pre-commit"
export HSM_BUILD_LOCK_PROTECT=1

touches_board=false
git diff --cached --name-only -- "hardware/pcb/pcba/" | grep -q . && touches_board=true

owed=0
ran=0
owed_names=""

# gate <name> <cmd…> — run a check; one ✓ line on pass, its full output on red.
#
# A RED CHECK DOES NOT HOLD THE COMMIT. The change lands, the deploy starts on it, and what
# the check found is the next commit's work. So this output is the whole of what says the
# tree is not clean — nothing downstream asks again, and the tally at the tail is what a
# reader who scrolled past the middle still sees.
gate() {
  _name=$1; shift
  ran=$((ran + 1))
  if _out=$("$@" 2>&1); then
    echo "pre-commit: $_name — checked ✓" >&2
  else
    echo "$_out" >&2
    echo "pre-commit: RED — $_name" >&2
    owed=$((owed + 1))
    owed_names="$owed_names
    - $_name"
  fi
}

# sync <name> <file> <cmd…> — re-derive <file>'s figures; if that moved them, stage it.
#
# A stale ledger figure is a number that needs copying, and the script reporting the
# drift is the script that copies it. So it copies it: the commit carries the fresh
# ledger and what moved shows up in the DIFF, which outlives a line of terminal output
# nobody scrolls back to. This is the treatment out/pcba.glb already gets below.
#
# It settles only what is derivable. An untagged BOM row, an estimate off the labor
# ladder, a §7 row with no print-rate group — each is a decision, not a copy, and the
# --check gates after these still stop the commit on them.
#
# Only the named file is staged, and only when the sync itself moved it, so a commit
# never sweeps up a neighbouring edit that happened to be dirty. Its figures sidecar
# goes with it and is weighed on its own: both move when a figure moves, and a sync
# that lands on the figures already recorded moves neither.
sync() {
  _name=$1; _file=$2; shift 2
  _car="${_file%.md}.figures.json"
  _was=$(git -C "$root" hash-object "$_file" 2>/dev/null)
  _carwas=$(git -C "$root" hash-object "$_car" 2>/dev/null)
  if _out=$("$@" 2>&1); then
    _now=$(git -C "$root" hash-object "$_file" 2>/dev/null)
    if [ "$(git -C "$root" hash-object "$_car" 2>/dev/null)" != "$_carwas" ]; then
      git -C "$root" add "$_car"
    fi
    if [ "$_was" != "$_now" ]; then
      git -C "$root" add "$_file"
      echo "pre-commit: $_name — re-derived and staged:" >&2
      echo "$_out" | head -6 | sed 's/^/    /' >&2
    else
      echo "pre-commit: $_name — staged ✓" >&2
    fi
  else
    echo "$_out" >&2
    echo "pre-commit: $_name — could not re-derive (the gate below reports it)" >&2
  fi
}

# ── 1. Ledger syncs, then 2. gates ────────────────────────────────────────
# staged <pathspec…> — true when the commit stages anything under these paths.
#
# EVERY GATE IS KEYED TO EXACTLY THE FILES IT READS, plus its own script. A gate
# keyed wider than its inputs charges every unrelated commit for an answer that
# could not have changed; a gate keyed narrower than its inputs silently stops
# running. So when a script grows an input, widen its key here in the same
# breath — the pathspec below IS the claim about what the script reads.
staged() {
  git diff --cached --name-only -- "$@" | grep -q .
}

for hw in $editions; do
  # BOM <-> pinout <-> PCB drift. Reads the board source, the pinout diagram,
  # bom.md, and the two assembly sync drivers — nothing else moves its answer.
  if staged "$hw/pcb/pcba/pcba.tsx" "$hw/wiring/esp32-pinout.mmd" "$hw/ledger/bom.md" \
            "$hw/assembly/_electronics_shelf_sync.py" \
            "$hw/assembly/_firmware_and_commissioning_sync.py" \
            "$hw/scripts/check_pinmap.py"; then
    gate "$hw pin-map drift check" python3 "$root/$hw/scripts/check_pinmap.py"
  fi

  # ── the ledger syncs, in the order the figures flow ─────────────────────
  # §7's masses come off the parts' own solids; the section and grand totals sum the
  # rows those masses price; the machine-hours ledger reads §7 to derive its print
  # hours, and its turnaround from those. A mass that moves has to reach all three,
  # so they run in that order and each sees the one before it.
  bom_md="$root/$hw/ledger/bom.md"

  touches_printed=false
  git diff --cached --name-only -- "$hw/printed-parts/" "$hw/ledger/bom.md" | grep -q . && touches_printed=true

  # bom.md §7 reads its masses off the parts' own solids, so a geometry change that
  # lands without carrying its mass leaves the ledger quoting a part that is not the
  # one that ships. The row and the STEP go in together. ~4 s, and it replaces the
  # --check that used to cost the same and then ask for this run anyway.
  #
  # A SYNC READS THE WORKING TREE AND STAGES WHAT IT WROTE, and those are two different
  # trees when somebody else is mid-edit. Only the file this sync moved is staged — but the
  # FIGURES in it came off whatever solids happen to be dirty, so a mass for a part nobody
  # has finished lands in this commit's diff under this commit's name. A solid held back is
  # a row that stays as it was, which the next commit to land that geometry re-derives.
  bom_synced=false
  if $touches_printed; then
    _mid=$(git -C "$root" diff --name-only -- "$hw/printed-parts/" | grep '\.step$' | head -3)
    if [ -n "$_mid" ]; then
      echo "pre-commit: $hw bom printed masses — held, these solids are mid-edit and their" >&2
      echo "pre-commit:   masses would be this commit's figures:" >&2
      echo "$_mid" | sed 's/^/      /' >&2
    elif [ -x "$py" ]; then
      sync "$hw bom printed masses" "$bom_md" "$py" "$root/$hw/scripts/_bom_masses.py"
      bom_synced=true
    else
      echo "pre-commit: no cad-venv — $hw bom printed masses skipped" >&2
    fi
  fi

  # The printed subtotals and the grand total sum the rows above them. They went
  # stale twice inside two days — a row's cost moved and the ledger's own total
  # disagreed with /cost, which sums the rows itself.
  if $bom_synced || staged "$hw/ledger/bom.md" "$hw/scripts/_bom_totals.py"; then
    sync "$hw bom totals" "$bom_md" python3 "$root/$hw/scripts/_bom_totals.py"
  fi

  # Cash-outlay ledger: section and grand totals summed off the purchase rows.
  # A row moving ON-ORDER → ACQUIRED moves two totals and touches neither by hand.
  if staged "$hw/ledger/purchases.md" "$hw/scripts/_ledger_totals.py"; then
    sync "$hw ledger totals" "$root/$hw/ledger/purchases.md" \
         python3 "$root/$hw/scripts/_ledger_totals.py"
  fi

  # Attended-minute ledger: subtotals summed off the rows.
  if staged "$hw/ledger/labor.md" "$hw/scripts/_labor_totals.py"; then
    sync "$hw labor totals" "$root/$hw/ledger/labor.md" \
         python3 "$root/$hw/scripts/_labor_totals.py"
  fi

  # Machine-hours ledger, keyed on bom.md too: it reads §7's masses for the print
  # hours, so a printed part that changes shape moves this ledger.
  if $bom_synced || staged "$hw/ledger/machine-time.md" "$hw/ledger/bom.md" \
                           "$hw/scripts/_machine_time.py"; then
    sync "$hw machine-time totals" "$root/$hw/ledger/machine-time.md" \
         python3 "$root/$hw/scripts/_machine_time.py"
  fi

  # ── the gates on what a sync cannot settle ──────────────────────────────
  # Every row carries a known category tag. There is no write mode: which section a
  # new row belongs in is a decision, so this one only ever reports.
  if staged "$hw/ledger/bom.md" "$hw/scripts/_bom_categories.py"; then
    gate "$hw bom category tags" python3 "$root/$hw/scripts/_bom_categories.py" --check
  fi

  # An estimate off the believable-increment ladder — 30 or 45, never 37 — is a
  # number someone has to choose, so the sync above leaves it standing.
  if staged "$hw/ledger/labor.md" "$hw/scripts/_labor_totals.py"; then
    gate "$hw labor ladder" python3 "$root/$hw/scripts/_labor_totals.py" --check
  fi

  # A §7 row with no print-rate group fails here rather than vanishing from the
  # turnaround and throughput figures. GROUP_OF is the decision the sync cannot make.
  if $bom_synced || staged "$hw/ledger/machine-time.md" "$hw/ledger/bom.md" \
                           "$hw/scripts/_machine_time.py"; then
    gate "$hw machine-time groups" python3 "$root/$hw/scripts/_machine_time.py" --check
  fi

  # Walks every .py under the edition for `raise SystemExit` in a lock-taking
  # script, so only a staged Python file can change its answer. Pathspec can't
  # express "*.py at any depth" portably — filter the staged list instead.
  if git diff --cached --name-only -- "$hw/" | grep -q '\.py$'; then
    gate "$hw build exit status" python3 "$root/$hw/scripts/check_build_exit.py"
  fi

  # The other half of `bodies-colored`: that gate rides the enclosure's card and asks whether
  # the ASSEMBLY painted each placed body. This asks what each body's OWN STEP carries, which
  # is what its card and /3d draw. A STEP is the only thing that moves the answer.
  if git diff --cached --name-only -- "$hw/" | grep -q '\.step$'; then
    gate "$hw a solid's STEP names its material" \
         python3 "$root/$hw/scripts/check_step_colours.py"
  fi

  # NOTHING HERE ASKS BAZEL ANYTHING. Whether the tree carries what the build cuts is a real
  # question and `bazel build //:everything` then `tools/bazel/sync_tree.py` is how it is
  # asked — but asking it HERE puts it in front of every commit, and one bazel command waits
  # on the workspace lock whatever it then does. A commit is the wrong place to learn that a
  # figure moved: the answer does not change what gets committed, it only delays it.
  #
  # AND THAT BOTH HALVES OF EVERY PAIR ARE IN THE INDEX. `git ls-files` and one read per doc,
  # no import and no venv, which is the whole of what this can afford to be.
  if git diff --cached --name-only -- "$hw/" | grep -q '\.py$'; then
    gate "$hw records are tracked beside what they describe" \
         python3 "$root/$hw/scripts/check_tracked.py"
  fi
done

# BUILD.bazel is written from graph.json, selftests.json and `git ls-files`. A commit that
# adds or deletes a tracked file moves the third; one that only edits a file does not.
if staged "BUILD.bazel" "tools/bazel/graph.json" "tools/bazel/selftests.json" ||
   git diff --cached --name-status | grep -q '^[AD]'; then
  gate "BUILD.bazel is what the traced graph writes" \
       python3 "$root/tools/bazel/gen_build.py" --check
fi

# A STEP HOLDS THE FILES IT DECLARED AND NOTHING ELSE, so a generator importing a module no
# step names raises ModuleNotFoundError on a file that is tracked, committed and sitting right
# there. `trace_inputs.py` records what a run was WATCHED opening, so an import added since
# that run is not in the graph until the run happens again. Ast plus a graph lookup; it starts
# no interpreter of this repo's and reads no geometry.
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.py$'; then
  gate "a staged module's imports are declared where it is read" \
       python3 "$root/tools/bazel/check_declared_imports.py"
fi

# RENDER.YAML'S OWN INSTALL COMMAND, ASKED HERE. `npm ci` stops when the lockfile and
# package.json disagree, so the pair moving apart is a deploy that fails at build time with
# a Render log for its only reader. It catches an `overrides` edit too, which the lockfile
# does not mirror in its root entry.
#
# `--offline` keeps the registry out of the commit path — the comparison is local and runs
# ahead of any fetch. `--ignore-scripts` because a check does not run a package's install hooks.
if staged "web/package.json" "web/package-lock.json"; then
  gate "web lockfile in sync with package.json" \
       sh -c "cd \"$root/web\" && npm ci --dry-run --omit=dev --offline --ignore-scripts"
fi

if $touches_board; then
  gate "scorecard fab-ready gates" python3 -c '
import json, sys
p = sys.argv[1]
try:
    sc = json.load(open(p))["scorecard"]
except Exception as e:
    sys.exit("cannot read the render scorecard in " + p + " (" + repr(e) + ") - run: bun render-board.ts pcba.tsx")
if not sc["gatesPass"]:
    for c in sc["checks"]:
        if c.get("kind") == "gate" and c["status"] != "pass":
            print("  gate red:", c["label"], "-", c["value"], "(target", c["target"] + ")", file=sys.stderr)
    sys.exit("BOARD NOT FAB-READY per the render scorecard")
' "$pcba/out/pcba.picks.json"

  gate "silk-audit" sh -c "cd \"$pcba\" && python3 silk-audit.py"

  if [ -x "$py" ]; then
    gate "part-orientation-audit" sh -c "cd \"$pcba\" && \"$py\" part-orientation-audit.py"
  else
    echo "pre-commit: no cad-venv — part-orientation-audit skipped" >&2
  fi
fi

# ── 3. GLB freshness ──────────────────────────────────────────────────────
if $touches_board && [ -f "$pcba/out/pcba.gerbers.zip" ]; then
  if [ ! -f "$pcba/out/pcba.glb" ] || [ "$pcba/out/pcba.gerbers.zip" -nt "$pcba/out/pcba.glb" ]; then
    if [ -x "$py" ]; then
      echo "pre-commit: out/pcba.glb is behind the gerbers — rebuilding the 3D (one-time, ~14 s)…" >&2
      if ( cd "$pcba" && "$py" board-3d.py ) >&2; then
        git -C "$root" add \
          hardware/pcb/pcba/out/pcba.glb \
          hardware/pcb/pcba/out/pcba.top3d.png \
          hardware/pcb/pcba/out/pcba.bottom3d.png
      else
        echo "pre-commit: board-3d failed — committing a possibly-stale GLB (rerun: tools/cad-venv/bin/python board-3d.py)" >&2
      fi
    else
      echo "pre-commit: no cad-venv — out/pcba.glb may be stale (run: tools/cad-venv/bin/python board-3d.py)" >&2
    fi
  fi
fi

# WHAT THIS IS GETS SAID ON THE PATH EVERY COMMIT TAKES. The line below said it only to a
# commit that broke something, so a run of green ✓ lines from a thing called `pre-commit`
# read as enforcement to everyone it never stopped — which is everyone.
echo "" >&2
if [ "$owed" -gt 0 ]; then
  echo "pre-commit: THIS COMMIT IS IN, and it owes a follow-up. $owed check(s) came back red:$owed_names" >&2
  echo "pre-commit: git push." >&2
else
  echo "pre-commit: THIS COMMIT IS IN. $ran checked, none red — nothing here holds a commit." >&2
fi

exit 0
