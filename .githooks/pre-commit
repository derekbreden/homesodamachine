#!/bin/sh
# WHAT HOLDS A COMMIT HERE IS "NOTHING SHIPS UNTIL THIS IS GONE", AND NOT WHETHER ANYTHING
# IS RED. A gate that reports a failing check is a gate nobody reads. Both faults below stop
# the publish outright, and the publish is the only road geometry takes to the site.
#
# A CYCLE fails bazel's LOADING phase, before any target is built: every one of them fails at
# once and none of the messages names the pair at fault.
#
# AN UNDECLARED READ fails one action — and the publish cuts a SET, so one action that will not
# run is a run that pins no lock, and no part ships, not just that one. The blast radius is the
# same; only the message differs.
#
# EACH GATE IS KEYED TO WHAT THE COMMIT TOUCHED, so a commit to web/ or a doc pays nothing, and
# a `.py` that no step reads reports nothing because no action holds it.
#
# THE IMPORT GATE NAMES A ONE-COMMAND CURE — `--fix` writes the edges it found, in seconds. What
# it cannot see is a solid a lazy path loads at runtime, which is a reading of the run and only
# `trace_inputs` takes it.
#
# HSM_SKIP_PRECOMMIT=1 skips both.
[ -n "$HSM_SKIP_PRECOMMIT" ] && exit 0
root=$(git rev-parse --show-toplevel) || exit 0
py="$root/tools/cad-venv/bin/python"
[ -x "$py" ] || py=python3
staged=$(git diff --cached --name-only --diff-filter=ACM)

# A GRAPH THAT COMES BACK AROUND. Three files decide the relation and no other can move it:
# `graph.json` is the record a rule's reads come from, `gen_build.py` is what turns a read into
# an edge, and BUILD.bazel is where the result lands.
case "$staged" in
  *tools/bazel/graph.json*|*tools/bazel/gen_build.py*|*BUILD.bazel*)
    "$py" "$root/tools/bazel/gen_build.py" --cycles || exit 1 ;;
esac

# A STEP THAT IMPORTS WHAT IT DOES NOT HOLD finds no module — `ModuleNotFoundError` on a file
# sitting tracked in the tree. This reads the staged `.py` and names every step that reaches it.
case "$staged" in
  *.py*) "$py" "$root/tools/bazel/check_declared_imports.py" || exit 1 ;;
esac

exit 0
