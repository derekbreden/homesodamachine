# The reason this repo is on Bazel. An action sees the files it declared and nothing else,
# so a generator that loads a solid it did not name fails where it used to read a stale one.
build --spawn_strategy=sandboxed,local
build --sandbox_default_allow_network=false

# The interpreter and its packages are not in the workspace; the geometry is. A genrule's own
# PATH stops at /usr/local/bin, which is where node is and where rsvg-convert and blender are
# not — so an action that draws a print or a line-art SVG needs the brew prefix named too.
build --sandbox_add_mount_pair=/opt/homebrew
build --sandbox_add_mount_pair=/usr/local
build --action_env=PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# The kept work is not a declared input and not an output: `_boxes` and `_meshes` name an entry
# by the serialized shape it came off, and `_realized` by that plus the digest of everything the
# action holds. An action that finds one has been given the same thing twice.
build --sandbox_add_mount_pair=/Users/derekbredensteiner/Developer/homesodamachine/.cache
build --action_env=HSM_SKIP_VIEWS=1
build --action_env=HSM_NO_BUILD_LOCK=1
build --action_env=HSM_SKIP_SCENES=1

# BAZEL IS ONE SCHEDULER AND `_run_lock` IS THE OTHER, and the box is eight cores. An action
# cannot take that lock — eight of them each taking a global single-flight mutex is a build
# that runs one action at a time — so what keeps the two from oversubscribing is this: bazel
# holds three quarters of the cores, and everything outside it shares the lock for the rest.
# `--jobs=auto` gave bazel all of them and left a trace, a hand run and a watcher to fight
# over the same eight.
build --jobs=HOST_CPUS*0.75
test --test_output=errors
