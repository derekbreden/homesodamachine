O6=$$PWD/$(location out/enclosure-assembly/hardware/assembly/scenes/glb/en04-compressor-bay.glb)
O7=$$PWD/$(location out/enclosure-assembly/hardware/assembly/scenes/glb/en07-electronics-bay.glb)
O8=$$PWD/$(location out/enclosure-assembly/hardware/assembly/scenes/glb/front-top.glb)
O9=$$PWD/$(location out/enclosure-assembly/hardware/assembly/scenes/glb/funnel-drain.glb)
