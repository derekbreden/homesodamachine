O5=$$PWD/$(location out/foam-assembly/hardware/printed-parts/cold-core/foam-assembly/internal-routes.step.mesh)
O6=$$PWD/$(location out/foam-assembly/hardware/printed-parts/cold-core/foam-assembly/internal-routes.step.npz)
rm -rf work-foam-assembly
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    *) t=$$f;;
  esac
  mkdir -p "work-foam-assembly/$$(dirname "$$t")"; copy_file -L "$$f" "work-foam-assembly/$$t"
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-foam-assembly/$$(dirname $$d); ln -sfn $$PWD/$$d work-foam-assembly/$$d; fi
done
cd work-foam-assembly
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D env -u HSM_SKIP_MESH_PAYLOAD $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/printed-parts/cold-core/foam-assembly/foam_assembly.py > /dev/null
copy_file hardware/printed-parts/cold-core/foam-assembly/foam-assembly.numbers.json "$$O0"
copy_file hardware/printed-parts/cold-core/foam-assembly/foam-assembly.step "$$O1"
copy_file hardware/printed-parts/cold-core/foam-assembly/foam-assembly.step.mesh "$$O2"
copy_file hardware/printed-parts/cold-core/foam-assembly/foam-assembly.step.npz "$$O3"
copy_file hardware/printed-parts/cold-core/foam-assembly/internal-routes.step "$$O4"
copy_file hardware/printed-parts/cold-core/foam-assembly/internal-routes.step.mesh "$$O5"
copy_file hardware/printed-parts/cold-core/foam-assembly/internal-routes.step.npz "$$O6"
cd .. && rm -rf work-foam-assembly
""",
)

