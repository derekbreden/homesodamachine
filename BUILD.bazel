    ],
    tags = ["no-sandbox"],
    cmd = """
set -e
case "$$(uname -s)" in
  Darwin)
    copy_mask=$$((8#$$(umask)))
    copy_bits=("" x w wx r rx rw rwx)
    copy_mode="u-$${copy_bits[$$((copy_mask >> 6 & 7))]},g-$${copy_bits[$$((copy_mask >> 3 & 7))]},o-$${copy_bits[$$((copy_mask & 7))]}"
    copy_file() {
      local copy_dest="$${!#}" copy_target copy_permissions="$$copy_mode"
      if [ -e "$$copy_dest" ] || [ -L "$$copy_dest" ]; then
        if [ ! -f "$$copy_dest" ] || [ -L "$$copy_dest" ]; then cp "$$@"; return; fi
        copy_permissions=$$(stat -f %Lp "$$copy_dest")
        copy_target=$$(mktemp "$$copy_dest.hsm-copy.XXXXXX")
      else copy_target="$$copy_dest"; fi
      if cp -c "$${@:1:$$(( $$# - 1 ))}" "$$copy_target" 2>/dev/null; then
        chmod "$$copy_permissions" "$$copy_target"
        touch "$$copy_target"
        if [ "$$copy_target" != "$$copy_dest" ]; then mv -f "$$copy_target" "$$copy_dest"; fi
      else rm -f "$$copy_target"; cp "$$@"; fi
    };;
  *) copy_file() { cp "$$@"; };;
esac
O0=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.step)
O1=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.step.mesh)
O2=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.step.npz)
O3=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.stl)
O4=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.step)
O5=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.step.mesh)
O6=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.step.npz)
O7=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.stl)
O8=$$PWD/$(location out/asse-straight-cuffs/hardware/printed-parts/asse-straight-cuffs/asse-straight-cuffs.numbers.json)
rm -rf work-asse-straight-cuffs
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    *) t=$$f;;
  esac
  mkdir -p "work-asse-straight-cuffs/$$(dirname "$$t")"; copy_file -L "$$f" "work-asse-straight-cuffs/$$t"
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-asse-straight-cuffs/$$(dirname $$d); ln -sfn $$PWD/$$d work-asse-straight-cuffs/$$d; fi
done
cd work-asse-straight-cuffs
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D env -u HSM_SKIP_MESH_PAYLOAD $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/printed-parts/asse-straight-cuffs/asse_straight_cuffs.py > /dev/null
copy_file hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.step "$$O0"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.step.mesh "$$O1"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.step.npz "$$O2"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-inlet-cuff.stl "$$O3"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.step "$$O4"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.step.mesh "$$O5"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.step.npz "$$O6"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-outlet-cuff.stl "$$O7"
copy_file hardware/printed-parts/asse-straight-cuffs/asse-straight-cuffs.numbers.json "$$O8"
cd .. && rm -rf work-asse-straight-cuffs
""",
)

