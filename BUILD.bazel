O7=$$PWD/$(location out/display-gasket/hardware/printed-parts/enclosure/display-gasket/display_gasket.py)
rm -rf work-display-gasket
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    */pysrc/*) t=$${f##*/pysrc/};;
    *) t=$$f;;
