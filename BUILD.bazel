O15=$$PWD/$(location out/plumbing-scenes/hardware/install-guide/plumbing/out/plumbing-valve-on.step.npz)
rm -rf work-plumbing-scenes
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    *) t=$$f;;
  esac
  mkdir -p "work-plumbing-scenes/$$(dirname "$$t")"; copy_file -L "$$f" "work-plumbing-scenes/$$t"
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-plumbing-scenes/$$(dirname $$d); ln -sfn $$PWD/$$d work-plumbing-scenes/$$d; fi
done
cd work-plumbing-scenes
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D env -u HSM_SKIP_MESH_PAYLOAD $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/install-guide/plumbing/plumbing_scenes.py > /dev/null
copy_file hardware/install-guide/plumbing/art/plumbing-pre-tee.png "$$O0"
copy_file hardware/install-guide/plumbing/art/plumbing-tee-installed.png "$$O1"
copy_file hardware/install-guide/plumbing/art/plumbing-valve-off.png "$$O2"
copy_file hardware/install-guide/plumbing/art/plumbing-valve-on.png "$$O3"
copy_file hardware/install-guide/plumbing/out/plumbing-pre-tee.step "$$O4"
copy_file hardware/install-guide/plumbing/out/plumbing-pre-tee.step.mesh "$$O5"
copy_file hardware/install-guide/plumbing/out/plumbing-pre-tee.step.npz "$$O6"
copy_file hardware/install-guide/plumbing/out/plumbing-tee-installed.step "$$O7"
copy_file hardware/install-guide/plumbing/out/plumbing-tee-installed.step.mesh "$$O8"
copy_file hardware/install-guide/plumbing/out/plumbing-tee-installed.step.npz "$$O9"
copy_file hardware/install-guide/plumbing/out/plumbing-valve-off.step "$$O10"
copy_file hardware/install-guide/plumbing/out/plumbing-valve-off.step.mesh "$$O11"
copy_file hardware/install-guide/plumbing/out/plumbing-valve-off.step.npz "$$O12"
copy_file hardware/install-guide/plumbing/out/plumbing-valve-on.step "$$O13"
copy_file hardware/install-guide/plumbing/out/plumbing-valve-on.step.mesh "$$O14"
copy_file hardware/install-guide/plumbing/out/plumbing-valve-on.step.npz "$$O15"
cd .. && rm -rf work-plumbing-scenes
""",
