set -e
O0=$$PWD/$(location out/display-gasket/hardware/printed-parts/enclosure/display-gasket/display-gasket.numbers.json)
O1=$$PWD/$(location out/display-gasket/hardware/printed-parts/enclosure/display-gasket/display-gasket.step)
O2=$$PWD/$(location out/display-gasket/hardware/printed-parts/enclosure/display-gasket/display-gasket.step.mesh)
O3=$$PWD/$(location out/display-gasket/hardware/printed-parts/enclosure/display-gasket/display-gasket.step.npz)
O4=$$PWD/$(location out/display-gasket/hardware/printed-parts/enclosure/display-gasket/display-gasket.stl)
O5=$$PWD/$(location out/display-gasket/hardware/printed-parts/enclosure/display-gasket/README.figures.json)
