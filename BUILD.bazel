        "pysrc/hardware/manifold-layout/manifold_layout.py",
        "pysrc/hardware/printed-parts/cadlib/snap.py",
        "pysrc/hardware/printed-parts/cadlib/world_workplane.py",
        "pysrc/hardware/printed-parts/cold-core/_cold_core_interface.py",
        "pysrc/hardware/printed-parts/cold-core/_port_cuts.py",
        "pysrc/hardware/printed-parts/cold-core/_reed_channels.py",
        "pysrc/hardware/printed-parts/cold-core/_support_ring.py",
        "pysrc/hardware/printed-parts/cold-core/reservoir/reservoir.py",
        "pysrc/hardware/printed-parts/enclosure/back-panel/_back_panel_dimensions.py",
        "pysrc/hardware/printed-parts/enclosure/pump-tray/pump_case.py",
        "pysrc/hardware/reference/beduan-solenoid/beduan_solenoid.py",
        "pysrc/hardware/reference/kamoer-kphm400/kamoer_kphm400.py",
        "pysrc/hardware/reference/tee-connector/tee_connector.py",
        "pysrc/hardware/reference/y-divider/y_divider.py",
        "pysrc/hardware/scripts/_boxes.py",
        "pysrc/hardware/scripts/_cadq_export.py",
        "pysrc/hardware/scripts/_materials.py",
        "pysrc/hardware/scripts/_measuring.py",
        "pysrc/hardware/scripts/_meshes.py",
        "pysrc/hardware/scripts/_overlap.py",
        "pysrc/hardware/scripts/_realized.py",
        "pysrc/hardware/scripts/_routing.py",
        "pysrc/hardware/scripts/_run_lock.py",
        "pysrc/hardware/scripts/_stated_bounds.py",
        "pysrc/hardware/wiring/_ac_wiring_schedule_sync.py",
        "pysrc/tools/docgen/__init__.py",
    ] + glob(
        [
            "hardware/assembly/acceptance-and-burn-in.figures.json",
        ],
        allow_empty = True,
    ),
    outs = [
        "out/acceptance-and-burn-in-sync/hardware/assembly/acceptance-and-burn-in.figures.json",
        "out/acceptance-and-burn-in-sync/hardware/assembly/acceptance-and-burn-in.md",
    ],
    cmd = """
set -e
O0=$$PWD/$(location out/acceptance-and-burn-in-sync/hardware/assembly/acceptance-and-burn-in.figures.json)
O1=$$PWD/$(location out/acceptance-and-burn-in-sync/hardware/assembly/acceptance-and-burn-in.md)
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    */pysrc/*) t=$${f##*/pysrc/};;
    *) t=$$f;;
  esac
  mkdir -p work/$$(dirname $$t); cp -L $$f work/$$t
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work/$$(dirname $$d); ln -sfn $$PWD/$$d work/$$d; fi
done
cd work
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/assembly/_acceptance_and_burn_in_sync.py > /dev/null
cp hardware/assembly/acceptance-and-burn-in.figures.json $$O0
cp hardware/assembly/acceptance-and-burn-in.md $$O1
""",
)

