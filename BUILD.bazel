    tags = ["no-sandbox"],
    cmd = """
set -e
case "$$(uname -s)" in
  Darwin)
    copy_mask=$$((8#$$(umask)))
    copy_bits=("" x w wx r rx rw rwx)
    copy_mode="u-$${copy_bits[$$((copy_mask >> 6 & 7))]},g-$${copy_bits[$$((copy_mask >> 3 & 7))]},o-$${copy_bits[$$((copy_mask & 7))]}"
    copy_file() {
      local copy_dest="$${!#}" copy_target copy_permissions="$$copy_mode"
      if [ -e "$$copy_dest" ] || [ -L "$$copy_dest" ]; then
        if [ ! -f "$$copy_dest" ] || [ -L "$$copy_dest" ]; then cp "$$@"; return; fi
        copy_permissions=$$(stat -f %Lp "$$copy_dest")
        copy_target=$$(mktemp "$$copy_dest.hsm-copy.XXXXXX")
      else copy_target="$$copy_dest"; fi
      if cp -c "$${@:1:$$(( $$# - 1 ))}" "$$copy_target" 2>/dev/null; then
        chmod "$$copy_permissions" "$$copy_target"
        touch "$$copy_target"
        if [ "$$copy_target" != "$$copy_dest" ]; then mv -f "$$copy_target" "$$copy_dest"; fi
      else rm -f "$$copy_target"; cp "$$@"; fi
    };;
  *) copy_file() { cp "$$@"; };;
esac
O0=$$PWD/$(location out/faucet-assembly/hardware/faucet-layout/faucet-assembly.numbers.json)
O1=$$PWD/$(location out/faucet-assembly/hardware/faucet-layout/faucet-assembly.step)
O2=$$PWD/$(location out/faucet-assembly/hardware/faucet-layout/faucet-assembly.step.mesh)
O3=$$PWD/$(location out/faucet-assembly/hardware/faucet-layout/faucet-assembly.step.npz)
O4=$$PWD/$(location out/faucet-assembly/hardware/faucet-layout/faucet_assembly.py)
rm -rf work-faucet-assembly
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    */pysrc/*) t=$${f##*/pysrc/};;
    *) t=$$f;;
  esac
  mkdir -p "work-faucet-assembly/$$(dirname "$$t")"; copy_file -L "$$f" "work-faucet-assembly/$$t"
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-faucet-assembly/$$(dirname $$d); ln -sfn $$PWD/$$d work-faucet-assembly/$$d; fi
done
cd work-faucet-assembly
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D env -u HSM_SKIP_MESH_PAYLOAD $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/faucet-layout/faucet_assembly.py > /dev/null
copy_file hardware/faucet-layout/faucet-assembly.numbers.json "$$O0"
copy_file hardware/faucet-layout/faucet-assembly.step "$$O1"
copy_file hardware/faucet-layout/faucet-assembly.step.mesh "$$O2"
copy_file hardware/faucet-layout/faucet-assembly.step.npz "$$O3"
copy_file hardware/faucet-layout/faucet_assembly.py "$$O4"
cd .. && rm -rf work-faucet-assembly
""",
)

