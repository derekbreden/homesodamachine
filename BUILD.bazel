    tags = ["no-sandbox"],
    cmd = """
set -e
O0=$$PWD/$(location out/opening-scene/hardware/install-guide/assets/opening-faucet-outline.svg)
O1=$$PWD/$(location out/opening-scene/hardware/install-guide/assets/opening.png)
O2=$$PWD/$(location out/opening-scene/hardware/install-guide/assets/print-resolution.json)
rm -rf work-opening-scene
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    */pysrc/*) t=$${f##*/pysrc/};;
    *) t=$$f;;
  esac
  mkdir -p work-opening-scene/$$(dirname $$t); cp -L $$f work-opening-scene/$$t
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-opening-scene/$$(dirname $$d); ln -sfn $$PWD/$$d work-opening-scene/$$d; fi
done
cd work-opening-scene
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/install-guide/opening_scene.py > /dev/null
cp hardware/install-guide/assets/opening-faucet-outline.svg $$O0
cp hardware/install-guide/assets/opening.png $$O1
cp hardware/install-guide/assets/print-resolution.json $$O2
cd .. && rm -rf work-opening-scene
""",
)

