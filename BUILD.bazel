    tags = ["no-sandbox"],
    cmd = """
set -e
case "$$(uname -s)" in
  Darwin)
    copy_mask=$$((8#$$(umask)))
    copy_bits=("" x w wx r rx rw rwx)
    copy_mode="u-$${copy_bits[$$((copy_mask >> 6 & 7))]},g-$${copy_bits[$$((copy_mask >> 3 & 7))]},o-$${copy_bits[$$((copy_mask & 7))]}"
    copy_file() {
      local copy_dest="$${!#}" copy_target copy_permissions="$$copy_mode"
      if [ -e "$$copy_dest" ] || [ -L "$$copy_dest" ]; then
        if [ ! -f "$$copy_dest" ] || [ -L "$$copy_dest" ]; then cp "$$@"; return; fi
        copy_permissions=$$(stat -f %Lp "$$copy_dest")
        copy_target=$$(mktemp "$$copy_dest.hsm-copy.XXXXXX")
      else copy_target="$$copy_dest"; fi
      if cp -c "$${@:1:$$(( $$# - 1 ))}" "$$copy_target" 2>/dev/null; then
        chmod "$$copy_permissions" "$$copy_target"
        touch "$$copy_target"
        if [ "$$copy_target" != "$$copy_dest" ]; then mv -f "$$copy_target" "$$copy_dest"; fi
      else rm -f "$$copy_target"; cp "$$@"; fi
    };;
  *) copy_file() { cp "$$@"; };;
esac
O0=$$PWD/$(location out/cold-core-assembly/hardware/cold-core-layout/cold-core-assembly.numbers.json)
O1=$$PWD/$(location out/cold-core-assembly/hardware/cold-core-layout/cold-core-assembly.scene.npz)
O2=$$PWD/$(location out/cold-core-assembly/hardware/cold-core-layout/cold-core-assembly.scorecard.json)
O3=$$PWD/$(location out/cold-core-assembly/hardware/cold-core-layout/cold-core-assembly.step)
O4=$$PWD/$(location out/cold-core-assembly/hardware/cold-core-layout/cold-core-assembly.step.mesh)
O5=$$PWD/$(location out/cold-core-assembly/hardware/cold-core-layout/cold-core-assembly.step.npz)
O6=$$PWD/$(location out/cold-core-assembly/hardware/printed-parts/cold-core/foam-assembly/foam-assembly.scorecard.json)
rm -rf work-cold-core-assembly
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    *) t=$$f;;
  esac
  mkdir -p "work-cold-core-assembly/$$(dirname "$$t")"; copy_file -L "$$f" "work-cold-core-assembly/$$t"
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-cold-core-assembly/$$(dirname $$d); ln -sfn $$PWD/$$d work-cold-core-assembly/$$d; fi
done
cd work-cold-core-assembly
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D env -u HSM_SKIP_MESH_PAYLOAD $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/cold-core-layout/cold_core_assembly.py > /dev/null
copy_file hardware/cold-core-layout/cold-core-assembly.numbers.json "$$O0"
copy_file hardware/cold-core-layout/cold-core-assembly.scene.npz "$$O1"
copy_file hardware/cold-core-layout/cold-core-assembly.scorecard.json "$$O2"
copy_file hardware/cold-core-layout/cold-core-assembly.step "$$O3"
copy_file hardware/cold-core-layout/cold-core-assembly.step.mesh "$$O4"
copy_file hardware/cold-core-layout/cold-core-assembly.step.npz "$$O5"
copy_file hardware/printed-parts/cold-core/foam-assembly/foam-assembly.scorecard.json "$$O6"
cd .. && rm -rf work-cold-core-assembly
""",
)

