done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-display-gasket/$$(dirname $$d); ln -sfn $$PWD/$$d work-display-gasket/$$d; fi
done
cd work-display-gasket
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D env -u HSM_SKIP_MESH_PAYLOAD $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/printed-parts/enclosure/display-gasket/display_gasket.py > /dev/null
cp hardware/printed-parts/enclosure/display-gasket/display-gasket.numbers.json $$O0
cp hardware/printed-parts/enclosure/display-gasket/display-gasket.step $$O1
cp hardware/printed-parts/enclosure/display-gasket/display-gasket.step.mesh $$O2
cp hardware/printed-parts/enclosure/display-gasket/display-gasket.step.npz $$O3
cp hardware/printed-parts/enclosure/display-gasket/display-gasket.stl $$O4
cp hardware/printed-parts/enclosure/display-gasket/README.figures.json $$O5
cp hardware/printed-parts/enclosure/display-gasket/README.md $$O6
cp hardware/printed-parts/enclosure/display-gasket/display_gasket.py $$O7
cd .. && rm -rf work-display-gasket
""",
)

