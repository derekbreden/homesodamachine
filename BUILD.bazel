O14=$$PWD/$(location out/enclosure-assembly/hardware/manifold-layout/enclosure-assembly.step)
O15=$$PWD/$(location out/enclosure-assembly/hardware/manifold-layout/enclosure-assembly.step.mesh)
O16=$$PWD/$(location out/enclosure-assembly/hardware/manifold-layout/enclosure-assembly.step.npz)
O17=$$PWD/$(location out/enclosure-assembly/hardware/wiring/enclosure-wiring.step)
O18=$$PWD/$(location out/enclosure-assembly/hardware/wiring/enclosure-wiring.step.mesh)
O19=$$PWD/$(location out/enclosure-assembly/hardware/wiring/enclosure-wiring.step.npz)
rm -rf work-enclosure-assembly
for f in $(SRCS); do
  case $$f in
    */node_modules/*) continue;;
    */bin/support/enclosure-assembly-graph.json) t=tools/bazel/graph.json;;
    */bin/out/*/*) t=$${f#*/bin/out/}; t=$${t#*/};;
    *) t=$$f;;
  esac
  mkdir -p "work-enclosure-assembly/$$(dirname "$$t")"; copy_file -L "$$f" "work-enclosure-assembly/$$t"
done
for d in tools/render/node_modules web/node_modules hardware/pcb/pcba/node_modules; do
  if [ -d $$d ]; then mkdir -p work-enclosure-assembly/$$(dirname $$d); ln -sfn $$PWD/$$d work-enclosure-assembly/$$d; fi
done
cd work-enclosure-assembly
ln -sfn $$HSM_WORKSPACE/.cache .cache
D=$$(find . -type f -name '*.step' -o -type f -name '*.dxf' -o -type f -name '*.stl' | sort | xargs cat 2>/dev/null | shasum -a 256 | cut -c1-32)
HSM_REPO_ROOT=$$PWD HSM_INPUT_DIGEST=$$D env -u HSM_SKIP_MESH_PAYLOAD $$HSM_WORKSPACE/tools/cad-venv/bin/python tools/run.py -- $$HSM_WORKSPACE/tools/cad-venv/bin/python hardware/manifold-layout/enclosure_assembly.py > /dev/null
copy_file hardware/assembly/scenes/glb/back-half.glb "$$O0"
copy_file hardware/assembly/scenes/glb/back-top.glb "$$O1"
copy_file hardware/assembly/scenes/glb/cap-lid-fill.glb "$$O2"
copy_file hardware/assembly/scenes/glb/cap-lid.glb "$$O3"
copy_file hardware/assembly/scenes/glb/cold-core-open.glb "$$O4"
copy_file hardware/assembly/scenes/glb/cold-core.glb "$$O5"
copy_file hardware/assembly/scenes/glb/en04-compressor-bay.glb "$$O6"
copy_file hardware/assembly/scenes/glb/en07-electronics-bay.glb "$$O7"
copy_file hardware/assembly/scenes/glb/front-top.glb "$$O8"
copy_file hardware/assembly/scenes/glb/funnel-drain.glb "$$O9"
copy_file hardware/assembly/scenes/glb/pump-mount.glb "$$O10"
copy_file hardware/manifold-layout/enclosure-assembly.facts.json "$$O11"
copy_file hardware/manifold-layout/enclosure-assembly.scene.npz "$$O12"
copy_file hardware/manifold-layout/enclosure-assembly.scorecard.json "$$O13"
copy_file hardware/manifold-layout/enclosure-assembly.step "$$O14"
copy_file hardware/manifold-layout/enclosure-assembly.step.mesh "$$O15"
copy_file hardware/manifold-layout/enclosure-assembly.step.npz "$$O16"
copy_file hardware/wiring/enclosure-wiring.step "$$O17"
copy_file hardware/wiring/enclosure-wiring.step.mesh "$$O18"
copy_file hardware/wiring/enclosure-wiring.step.npz "$$O19"
cd .. && rm -rf work-enclosure-assembly
""",
)

