O5=$$PWD/$(location out/plumbing-scenes/hardware/install-guide/plumbing/out/plumbing-pre-tee.step.mesh)
O6=$$PWD/$(location out/plumbing-scenes/hardware/install-guide/plumbing/out/plumbing-pre-tee.step.npz)
O7=$$PWD/$(location out/plumbing-scenes/hardware/install-guide/plumbing/out/plumbing-tee-installed.step)
