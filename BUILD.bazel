cargo=$$(command -v cargo || true)
for c in "$$cargo" /opt/homebrew/opt/rustup/bin/cargo ~/.cargo/bin/cargo; do if [ -x "$$c" ]; then cargo=$$c; break; fi; done
if [ ! -x "$$cargo" ]; then echo "cargo is not installed (https://rustup.rs)" >&2; exit 1; fi
export HOME=~ PATH="$$(dirname "$$cargo"):$$PATH"
O0=$$PWD/$(location out/enclosure-back-top-program/enclosure-back-top)
cd "$$HSM_WORKSPACE/tools/hsm"
CARGO_TARGET_DIR="$$PWD/target" "$$hsm_run" -- "$$cargo" build --release --locked --quiet --manifest-path enclosure-back-top/Cargo.toml --bin enclosure-back-top
copy_file target/release/enclosure-back-top "$$O0"
""",
)

