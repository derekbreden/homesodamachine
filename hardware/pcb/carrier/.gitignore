# dependencies
node_modules

# tscircuit build cache + local registry/parts cache
dist
.tscircuit
*.tsbuildinfo
.cache

# out/ holds only what render-board.ts maintains (the three copper views +
# gerbers). Other tsci exports are regenerable and would silently drift, so
# they're never committed — ignored here even if a local export writes them.
out/*.step
out/*.pcb.svg
out/*.pcb.png
out/*.sch.svg
out/*.sch.png
out/*.kicad_pcb
out/*.netlist.txt
out/*.specctra-dsn
out/*.dsn

# misc
*.tgz
coverage
*.lcov
.env
.env.*.local
logs
*.log
.DS_Store
.idea
