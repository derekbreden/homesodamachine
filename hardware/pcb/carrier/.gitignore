# dependencies
node_modules

# tscircuit build cache + local registry/parts cache
dist
.tscircuit
*.tsbuildinfo
.cache

# out/ keeps ONLY the real board's render outputs (render-board.ts: the three
# copper views + gerbers + picks). Everything else is regenerable and an upload
# decoy — other tsci export formats, the empty render of the carrier_parts
# footprint helper (it has no board), and any _-prefixed scratch board. So:
# ignore all of out/, then whitelist exactly mini's artifacts.
out/*
!out/mini.top.svg
!out/mini.top.png
!out/mini.bottom.svg
!out/mini.bottom.png
!out/mini.overlay.svg
!out/mini.overlay.png
!out/mini.gerbers.zip
!out/mini.picks.json

# misc
*.circuit.tmp.json
*.tgz
coverage
*.lcov
.env
.env.*.local
logs
*.log
.DS_Store
.idea
