+/**
+ * THROUGH-HOLE via mode helper. A node is via-capable only where the entire board column is
+ * clear (availableZ spans all layers). A node with a strict subset of layers free has an
+ * obstacle on the missing layer(s), so a via born there would be blind/buried or drill that
+ * obstacle — split it into one single-layer node per free layer. Single-layer and full-stack
+ * nodes pass through unchanged.
+ */
+function splitNonViaCapableNodes(
+  nodes: CapacityMeshNode[],
+  layerCount: number,
+): CapacityMeshNode[] {
+  const out: CapacityMeshNode[] = []
+  for (const node of nodes) {
+    const z = node.availableZ
+    if (z.length <= 1 || z.length >= layerCount) {
+      out.push(node)
+      continue
+    }
+    for (const singleZ of z) {
+      out.push({
+        ...node,
+        capacityMeshNodeId: `${node.capacityMeshNodeId}_thz${singleZ}`,
+        availableZ: [singleZ],
+      })
+    }
+  }
+  return out
+}
