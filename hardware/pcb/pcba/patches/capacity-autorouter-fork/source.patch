diff --git a/lib/utils/convertHdRouteToSimplifiedRoute.ts b/lib/utils/convertHdRouteToSimplifiedRoute.ts
index 8bb842b..ac3d690 100644
--- a/lib/utils/convertHdRouteToSimplifiedRoute.ts
+++ b/lib/utils/convertHdRouteToSimplifiedRoute.ts
@@ -22,6 +22,31 @@ const DEFAULT_TERMINAL_VIA_ATTACH_TOLERANCE = 0.25
 const SAME_POINT_TOLERANCE = 1e-12
 const SAME_NET_OBSTACLE_TOLERANCE = 1e-6
 
+// homesodamachine fork: when TSCIRCUIT_THROUGH_HOLE_VIAS is set, the router emits only full-stack
+// (top<->bottom) vias instead of the blind/buried consecutive-z spans it places internally —
+// JLCPCB standard assembly drills through-holes only. Off by default, so upstream behavior is
+// unchanged unless a consumer opts in.
+const isThroughHoleViasOnly = () =>
+  typeof process !== "undefined" &&
+  (process.env?.TSCIRCUIT_THROUGH_HOLE_VIAS === "1" ||
+    process.env?.TSCIRCUIT_THROUGH_HOLE_VIAS === "true")
+
+// Rewrite every via in a finished route to span the full copper stack. Sound because the router's
+// route-vs-route via conflict model is already full-column (a via reserves its (x,y) against other
+// routes on all layers), and via candidates are kept off pads by the mesh; the board DRC proves no
+// barrel crosses foreign copper. No-op on <=2-layer boards (every via is top<->bottom already).
+const normalizeViasToThroughHole = (
+  route: SimplifiedPcbTraces[number]["route"],
+  layerCount: number,
+): SimplifiedPcbTraces[number]["route"] => {
+  if (!isThroughHoleViasOnly() || layerCount <= 2) return route
+  const top = mapZToLayerName(0, layerCount)
+  const bottom = mapZToLayerName(layerCount - 1, layerCount)
+  return route.map((seg) =>
+    seg.route_type === "via" ? { ...seg, from_layer: top, to_layer: bottom } : seg,
+  )
+}
