# dependencies
node_modules

# tscircuit build cache + local registry/parts cache
dist
.tscircuit
*.tsbuildinfo
.cache

# out/ is the committed deploy payload: render-board.ts writes the real board's
# artifacts as out/<board>.* (copper views + inner planes + solder masks + gerbers +
# BOM/CPL + picks). A board is <dir>/<dir>.tsx (walkPcbBoards in web/lib/walk.js), so
# the only non-scratch files here are <board>.* for the real board — they commit
# automatically, every view kind, with no per-kind allowlist to forget (that gap once
# shipped the mask views' code but not their artifacts, so the deployed viewer's toggle
# found no file). Ignore only underscore-prefixed scratch: this render's build
# intermediates (out/_build-<board>.*, swept at the start of each render by
# render-board.ts) and any abandoned experiment outputs (_comb.*, _r_auto.*, _b*.tmp.*).
out/_*

# tscircuit circuit-json is a regenerable intermediate — render-board re-exports
# it every run for the back-silk + pick synthesis, so it drifts and bloats.
# Never committed (same policy as the tsci exports above).
*.circuit.json

# manual circuit-json export scratch (bunx tsci export -f circuit-json ... -o _cjtmp.json)
_cjtmp.json

# misc
*.circuit.tmp.json
*.tgz
coverage
*.lcov
.env
.env.*.local
logs
*.log
.DS_Store
.idea

# atomic-write / clearance-sweep scratch (._foo.tsx working copies, *.tmp.* renames,
# *.tmp.ts sweep/analysis scripts)
._*
*.tmp.tsx
*.tmp.ts
