{
  "purpose": "Measure the photographed long running face, foot bearings, crown and retaining shoulders in the new Mark1 toolpaths against the plate Derek tried in hand.",
  "gcode_sha256": "c903e26179086c2a47807c69fddef269c8fecd5aee34ee3110497ba59658076f",
  "previous_plate_gcode_sha256": "55319876a8452a37fa63aff0c7c3f43ee217d729b680a480a1abc34d3ac091bc",
