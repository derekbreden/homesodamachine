{
  "purpose": "Check both printed landings of every first-course road at the Pisco receiver's flat catches.",
  "gcode_sha256": "255ef1404e850318974986dc432fb96e6005741f25047dc927c08748e53ad64c",
  "geometry_input_sha256": "471f235bae71003e6ca486622e6ceb480df35b195d37e9125c56ea716cb15ec9",
