  %% DERIVED VIEW — the canonical pin map is hardware/pcb/pcba/pcba.tsx
  %% (PCB-canonical). Keep this in sync with the board; do not change a pin
  %% assignment here without changing pcba.tsx first.
  %%
  %% ═══════════════════════════════════════
  %%  Valve Control + Flavor-Reservoir Level Sensing
  %%  MCP23017 ×2 + ULN2803A ×2 (valves), reed inputs
  %% ═══════════════════════════════════════
  %%
  %% Two MCP23017 expanders on the shared I2C bus. Each one splits cleanly —
  %% Port A drives its own ULN2803A (outputs), Port B reads reeds (inputs):
  %%   0x20  8 valve outputs (V-A..V-H) on Port A -> ULN2803A #1 -> MANIFOLD A;
  %%         4 reservoir-A reed inputs on Port B[0:3]; PB[4:7] spare.
  %%   0x21  4 valve outputs (V-I/V-J/V-K-A/V-K-B) on Port A[4:7] + condenser fan
  %%         on PA3 -> ULN2803A #2 (ch 1-5) -> MANIFOLD B; PA[0:2] spare;
  %%         4 reservoir-B reed inputs on Port B[0:3]; 2 carbonator reeds on
  %%         PB[4:5]; PB[6:7] spare.
  %%
  %%  Bit order: the ULN2803A modules mount silk-side-up, which reverses their
  %%  input row, so on the board GPA_k drives ULN channel (8-k) — the GPA bit
  %%  order runs OPPOSITE the channel/valve order (0x20 GPA0->V-H .. GPA7->V-A;
  %%  0x21 GPA7->V-I .. GPA3->fan, GPA[0:2] spare). Port B (reeds) is unaffected.
  %%
  %% Level sensing rides the MCP internal pull-ups (no external resistors):
  %% the 8 reservoir reeds (4 per reservoir × 2) plus the 2 carbonator reeds,
  %% 10 reed inputs total. Reservoir A's 4 reeds land on 0x20 PB[0:3]; Reservoir
  %% B's 4 reeds on 0x21 PB[0:3]; the carbonator's low/high reeds on 0x21 PB[4:5].
  %% PA3 of 0x21 drives the condenser fan via ULN2803A #2 channel 5 (the fan is a
  %% 12 V DC brushless axial — see `power.mmd`).
  %%
  %% Conditional: 0x21 could be replaced by a 74HC165 shift register or
  %% direct ESP32 GPIO — saves the chip, decision deferred. (It now also
  %% carries the carbonator reeds, so the direct-GPIO option would draw
  %% from the spares 15/12/2 + input-only 36; GPIO 4 = buzzer, 39 = gas sensor.)
  %%
  %% Architecture detail at
  %% hardware/printed-parts/cold-core/reservoir/level-sensing.md.

  subgraph ESP32["ESP32  I2C Bus"]
    direction TB
    SDA["GPIO 21  SDA"]
    SCL["GPIO 22  SCL"]
  end

  subgraph I2C_Bus["I2C Bus  (shared)"]
    direction TB
    RTC["DS3231 RTC\n0x68"]
    MCP0["MCP23017\n0x20 (8 valves + 4 reed inputs)"]
    MCP1["MCP23017\n0x21 (4 valves + fan + 6 reed inputs)"]
  end

  subgraph Expander0["MCP23017 0x20 — 16 GPIO"]
    direction TB

    subgraph PortA0["Port A  (GPA0–7) — OUTPUTS"]
      direction TB
      A0_GPA0["GPA0 → V-H"]
      A0_GPA1["GPA1 → V-G"]
      A0_GPA2["GPA2 → V-F"]
      A0_GPA3["GPA3 → V-E"]
      A0_GPA4["GPA4 → V-D"]
      A0_GPA5["GPA5 → V-C"]
      A0_GPA6["GPA6 → V-B"]
      A0_GPA7["GPA7 → V-A"]
    end

    subgraph PortB0["Port B  (GPB0–7) — INPUTS"]
      direction TB
      A0_GPB0["GPB0 ← Rsvr A reed 1 / EMPTY"]
      A0_GPB1["GPB1 ← Rsvr A reed 2"]
      A0_GPB2["GPB2 ← Rsvr A reed 3"]
      A0_GPB3["GPB3 ← Rsvr A reed 4 / FULL"]
      A0_GPB4["GPB4  spare"]
      A0_GPB5["GPB5  spare"]
      A0_GPB6["GPB6  spare"]
      A0_GPB7["GPB7  spare"]
    end
  end

  subgraph Expander1["MCP23017 0x21 — 16 GPIO  (6 INPUTS, 1 OUTPUT, 9 SPARE)"]
    direction TB

    subgraph PortA1["Port A  (GPA0–7) — OUTPUTS  (4 valves + cond fan + 3 spare)"]
      direction TB
      A1_GPA0["GPA0  spare"]
      A1_GPA1["GPA1  spare"]
      A1_GPA2["GPA2  spare"]
      A1_GPA3["GPA3 → Cond fan"]
      A1_GPA4["GPA4 → V-K-B"]
      A1_GPA5["GPA5 → V-K-A"]
      A1_GPA6["GPA6 → V-J"]
      A1_GPA7["GPA7 → V-I"]
    end

    subgraph PortB1["Port B  (GPB0–7) — INPUTS  (Rsvr B reeds + carbonator reeds + 2 spare)"]
      direction TB
      A1_GPB0["GPB0 ← Rsvr B reed 1 / EMPTY"]
      A1_GPB1["GPB1 ← Rsvr B reed 2"]
      A1_GPB2["GPB2 ← Rsvr B reed 3"]
      A1_GPB3["GPB3 ← Rsvr B reed 4 / FULL"]
      A1_GPB4["GPB4 ← Carbonator reed LOW / refill"]
      A1_GPB5["GPB5 ← Carbonator reed HIGH / full"]
      A1_GPB6["GPB6  spare"]
      A1_GPB7["GPB7  spare"]
    end
  end

  subgraph Darlingtons["ULN2803A Darlington Arrays"]
    direction TB

    subgraph U1["U1 — Channels 1-8"]
      direction TB
      U1_1["1 → V-A"]
      U1_2["2 → V-B"]
      U1_3["3 → V-C"]
      U1_4["4 → V-D"]
      U1_5["5 → V-E"]
      U1_6["6 → V-F"]
      U1_7["7 → V-G"]
      U1_8["8 → V-H"]
    end

    subgraph U2["U2 — Channels 1-5 used"]
      direction TB
      U2_1["1 → V-I"]
      U2_2["2 → V-J"]
      U2_3["3 → V-K-A"]
      U2_4["4 → V-K-B"]
      U2_5["5 → Cond fan"]
      U2_free["6-8  free"]
    end
  end

  subgraph Valves["Solenoid Valves  (12V, normally closed)"]
    direction TB

    subgraph Shared_Valves["Source Selection"]
      VA["V-A  Tap water gate"]
      VB["V-B  Hopper gate"]
      VC["V-C  Channel A select"]
      VD["V-D  Channel B select"]
      VKA["V-K-A  BiB A gate"]
      VKB["V-K-B  BiB B gate"]
    end

    subgraph ChA_Valves["Channel A"]
      VE["V-E  Bag A → Pump A"]
      VF["V-F  Pump A → Bag A"]
      VG["V-G  Pump A → Nozzle A"]
    end

    subgraph ChB_Valves["Channel B"]
      VH["V-H  Bag B → Pump B"]
      VI["V-I  Pump B → Bag B"]
      VJ["V-J  Pump B → Nozzle B"]
    end
  end

  subgraph Reeds["Reed Switches  (INPUT_PULLUP, magnet pulls LOW)"]
    direction TB

    subgraph RsvrA["Reservoir A — bottom (reed 1) to top (reed 4)"]
      direction TB
      RA1["Reed 1  EMPTY threshold"]
      RA2["Reed 2"]
      RA3["Reed 3"]
      RA4["Reed 4  FULL threshold"]
    end

    subgraph RsvrB["Reservoir B — bottom (reed 1) to top (reed 4)"]
      direction TB
      RB1["Reed 1  EMPTY threshold"]
      RB2["Reed 2"]
      RB3["Reed 3"]
      RB4["Reed 4  FULL threshold"]
    end

    subgraph Carb["Carbonator vessel — 2 reeds (threshold-only)"]
      direction TB
      CARB_LO["Reed LOW  refill threshold"]
      CARB_HI["Reed HIGH  full threshold"]
    end
  end

  %% ── I2C wiring ──
  SDA & SCL <-->|"I2C"| RTC
  SDA & SCL <-->|"I2C"| MCP0
  SDA & SCL <-->|"I2C"| MCP1

  %% ── 0x20 Port A → U1  (GPA bit order reversed: GPA_k → channel 8-k) ──
  A0_GPA0 --> U1_8
  A0_GPA1 --> U1_7
  A0_GPA2 --> U1_6
  A0_GPA3 --> U1_5
  A0_GPA4 --> U1_4
  A0_GPA5 --> U1_3
  A0_GPA6 --> U1_2
  A0_GPA7 --> U1_1

  %% ── 0x21 Port A[4:7] → U2 ch1-4  (MANIFOLD B valves; GPA bit order reversed) ──
  A1_GPA7 --> U2_1
  A1_GPA6 --> U2_2
  A1_GPA5 --> U2_3
  A1_GPA4 --> U2_4

  %% ── 0x20 Port B[0:3] ← Reservoir A reeds 1-4 ──
  RA1 -->|"INPUT_PULLUP"| A0_GPB0
  RA2 -->|"INPUT_PULLUP"| A0_GPB1
  RA3 -->|"INPUT_PULLUP"| A0_GPB2
  RA4 -->|"INPUT_PULLUP"| A0_GPB3

  %% ── 0x21 Port B[0:3] ← Reservoir B reeds 1-4 ──
  RB1 -->|"INPUT_PULLUP"| A1_GPB0
  RB2 -->|"INPUT_PULLUP"| A1_GPB1
  RB3 -->|"INPUT_PULLUP"| A1_GPB2
  RB4 -->|"INPUT_PULLUP"| A1_GPB3

  %% ── 0x21 Port B[4:5] ← Carbonator reeds low/high ──
  CARB_LO -->|"INPUT_PULLUP"| A1_GPB4
  CARB_HI -->|"INPUT_PULLUP"| A1_GPB5

  %% ── U1 → Valves ──
  U1_1 ==> VA
  U1_2 ==> VB
  U1_3 ==> VC
  U1_4 ==> VD
  U1_5 ==> VE
  U1_6 ==> VF
  U1_7 ==> VG
  U1_8 ==> VH

  %% ── U2 → Valves ──
  U2_1 ==> VI
  U2_2 ==> VJ
  U2_3 ==> VKA
  U2_4 ==> VKB

  %% ── 0x21 PA3 → U2 ch5 (condenser fan low-side switch) ──
  A1_GPA3 --> U2_5

