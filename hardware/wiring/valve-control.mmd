flowchart LR

  %% ═══════════════════════════════════════
  %%  Valve Control + Flavor-Reservoir Level Sensing
  %%  MCP23017 ×2 + ULN2803A ×2 (valves), reed inputs
  %% ═══════════════════════════════════════
  %%
  %% Two MCP23017 expanders on the shared I2C bus:
  %%   0x20  outputs (valves) on Port A + Port B[0:3];
  %%         inputs (4 reservoir reed switches) on Port B[4:7]
  %%   0x21  inputs only (16 reservoir reed switches)
  %%
  %% Reservoir level sensing: 10 reeds per reservoir × 2 reservoirs
  %% = 20 inputs. Allocation puts the top 2 reeds of each reservoir
  %% on 0x20 PB[4:7] (the existing chip's 4 spare bits) and the
  %% remaining 16 reeds (8 per reservoir, low-to-high indices 1-8)
  %% on 0x21. Both chips end fully used after this addition.
  %%
  %% Architecture detail at
  %% hardware/printed-parts/cold-core/reservoir/level-sensing.md.

  subgraph ESP32["ESP32  I2C Bus"]
    direction TB
    SDA["GPIO 21  SDA"]
    SCL["GPIO 22  SCL"]
  end

  subgraph I2C_Bus["I2C Bus  (shared)"]
    direction TB
    RTC["DS3231 RTC\n0x68"]
    MCP0["MCP23017\n0x20 (valves + 4 reed inputs)"]
    MCP1["MCP23017\n0x21 (16 reed inputs)"]
  end

  subgraph Expander0["MCP23017 0x20 — 16 GPIO"]
    direction TB

    subgraph PortA0["Port A  (GPA0–7) — OUTPUTS"]
      direction TB
      A0_GPA0["GPA0 → V-A"]
      A0_GPA1["GPA1 → V-B"]
      A0_GPA2["GPA2 → V-C"]
      A0_GPA3["GPA3 → V-D"]
      A0_GPA4["GPA4 → V-E"]
      A0_GPA5["GPA5 → V-F"]
      A0_GPA6["GPA6 → V-G"]
      A0_GPA7["GPA7 → V-H"]
    end

    subgraph PortB0["Port B  (GPB0–7) — OUTPUTS + INPUTS"]
      direction TB
      A0_GPB0["GPB0 → V-I"]
      A0_GPB1["GPB1 → V-J"]
      A0_GPB2["GPB2 → V-K-A"]
      A0_GPB3["GPB3 → V-K-B"]
      A0_GPB4["GPB4 ← Reservoir A reed 9 (in)"]
      A0_GPB5["GPB5 ← Reservoir A reed 10 / FULL (in)"]
      A0_GPB6["GPB6 ← Reservoir B reed 9 (in)"]
      A0_GPB7["GPB7 ← Reservoir B reed 10 / FULL (in)"]
    end
  end

  subgraph Expander1["MCP23017 0x21 — 16 GPIO  (all INPUTS)"]
    direction TB

    subgraph PortA1["Port A  (GPA0–7) — Reservoir A reeds 1-8"]
      direction TB
      A1_GPA0["GPA0 ← Rsvr A reed 1 / EMPTY"]
      A1_GPA1["GPA1 ← Rsvr A reed 2"]
      A1_GPA2["GPA2 ← Rsvr A reed 3"]
      A1_GPA3["GPA3 ← Rsvr A reed 4"]
      A1_GPA4["GPA4 ← Rsvr A reed 5"]
      A1_GPA5["GPA5 ← Rsvr A reed 6"]
      A1_GPA6["GPA6 ← Rsvr A reed 7"]
      A1_GPA7["GPA7 ← Rsvr A reed 8"]
    end

    subgraph PortB1["Port B  (GPB0–7) — Reservoir B reeds 1-8"]
      direction TB
      A1_GPB0["GPB0 ← Rsvr B reed 1 / EMPTY"]
      A1_GPB1["GPB1 ← Rsvr B reed 2"]
      A1_GPB2["GPB2 ← Rsvr B reed 3"]
      A1_GPB3["GPB3 ← Rsvr B reed 4"]
      A1_GPB4["GPB4 ← Rsvr B reed 5"]
      A1_GPB5["GPB5 ← Rsvr B reed 6"]
      A1_GPB6["GPB6 ← Rsvr B reed 7"]
      A1_GPB7["GPB7 ← Rsvr B reed 8"]
    end
  end

  subgraph Darlingtons["ULN2803A Darlington Arrays"]
    direction TB

    subgraph U1["U1 — Channels 1-8"]
      direction TB
      U1_1["1 → V-A"]
      U1_2["2 → V-B"]
      U1_3["3 → V-C"]
      U1_4["4 → V-D"]
      U1_5["5 → V-E"]
      U1_6["6 → V-F"]
      U1_7["7 → V-G"]
      U1_8["8 → V-H"]
    end

    subgraph U2["U2 — Channels 1-4 used"]
      direction TB
      U2_1["1 → V-I"]
      U2_2["2 → V-J"]
      U2_3["3 → V-K-A"]
      U2_4["4 → V-K-B"]
      U2_free["5-8  free"]
    end
  end

  subgraph Valves["Solenoid Valves  (12V, normally closed)"]
    direction TB

    subgraph Shared_Valves["Source Selection"]
      VA["V-A  Tap water gate"]
      VB["V-B  Hopper gate"]
      VC["V-C  Channel A select"]
      VD["V-D  Channel B select"]
      VKA["V-K-A  BiB A gate"]
      VKB["V-K-B  BiB B gate"]
    end

    subgraph ChA_Valves["Channel A"]
      VE["V-E  Bag A → Pump A"]
      VF["V-F  Pump A → Bag A"]
      VG["V-G  Pump A → Nozzle A"]
    end

    subgraph ChB_Valves["Channel B"]
      VH["V-H  Bag B → Pump B"]
      VI["V-I  Pump B → Bag B"]
      VJ["V-J  Pump B → Nozzle B"]
    end
  end

  subgraph Reeds["Reservoir Reed Switches  (10 per reservoir, INPUT_PULLUP, magnet pulls LOW)"]
    direction TB

    subgraph RsvrA["Reservoir A — bottom (reed 1) to top (reed 10)"]
      direction TB
      RA1["Reed 1  EMPTY threshold"]
      RA2["Reed 2"]
      RA3["Reed 3"]
      RA4["Reed 4"]
      RA5["Reed 5"]
      RA6["Reed 6"]
      RA7["Reed 7"]
      RA8["Reed 8"]
      RA9["Reed 9"]
      RA10["Reed 10  FULL threshold"]
    end

    subgraph RsvrB["Reservoir B — bottom (reed 1) to top (reed 10)"]
      direction TB
      RB1["Reed 1  EMPTY threshold"]
      RB2["Reed 2"]
      RB3["Reed 3"]
      RB4["Reed 4"]
      RB5["Reed 5"]
      RB6["Reed 6"]
      RB7["Reed 7"]
      RB8["Reed 8"]
      RB9["Reed 9"]
      RB10["Reed 10  FULL threshold"]
    end
  end

  %% ── I2C wiring ──
  SDA & SCL <-->|"I2C"| RTC
  SDA & SCL <-->|"I2C"| MCP0
  SDA & SCL <-->|"I2C"| MCP1

  %% ── 0x20 Port A → U1 ──
  A0_GPA0 --> U1_1
  A0_GPA1 --> U1_2
  A0_GPA2 --> U1_3
  A0_GPA3 --> U1_4
  A0_GPA4 --> U1_5
  A0_GPA5 --> U1_6
  A0_GPA6 --> U1_7
  A0_GPA7 --> U1_8

  %% ── 0x20 Port B[0:3] → U2 ──
  A0_GPB0 --> U2_1
  A0_GPB1 --> U2_2
  A0_GPB2 --> U2_3
  A0_GPB3 --> U2_4

  %% ── 0x20 Port B[4:7] ← top 2 reeds of each reservoir ──
  RA9 -->|"INPUT_PULLUP"| A0_GPB4
  RA10 -->|"INPUT_PULLUP"| A0_GPB5
  RB9 -->|"INPUT_PULLUP"| A0_GPB6
  RB10 -->|"INPUT_PULLUP"| A0_GPB7

  %% ── 0x21 Port A ← Reservoir A reeds 1-8 ──
  RA1 -->|"INPUT_PULLUP"| A1_GPA0
  RA2 -->|"INPUT_PULLUP"| A1_GPA1
  RA3 -->|"INPUT_PULLUP"| A1_GPA2
  RA4 -->|"INPUT_PULLUP"| A1_GPA3
  RA5 -->|"INPUT_PULLUP"| A1_GPA4
  RA6 -->|"INPUT_PULLUP"| A1_GPA5
  RA7 -->|"INPUT_PULLUP"| A1_GPA6
  RA8 -->|"INPUT_PULLUP"| A1_GPA7

  %% ── 0x21 Port B ← Reservoir B reeds 1-8 ──
  RB1 -->|"INPUT_PULLUP"| A1_GPB0
  RB2 -->|"INPUT_PULLUP"| A1_GPB1
  RB3 -->|"INPUT_PULLUP"| A1_GPB2
  RB4 -->|"INPUT_PULLUP"| A1_GPB3
  RB5 -->|"INPUT_PULLUP"| A1_GPB4
  RB6 -->|"INPUT_PULLUP"| A1_GPB5
  RB7 -->|"INPUT_PULLUP"| A1_GPB6
  RB8 -->|"INPUT_PULLUP"| A1_GPB7

  %% ── U1 → Valves ──
  U1_1 ==> VA
  U1_2 ==> VB
  U1_3 ==> VC
  U1_4 ==> VD
  U1_5 ==> VE
  U1_6 ==> VF
  U1_7 ==> VG
  U1_8 ==> VH

  %% ── U2 → Valves ──
  U2_1 ==> VI
  U2_2 ==> VJ
  U2_3 ==> VKA
  U2_4 ==> VKB

  %% Free pins dimmed
  style U2_free fill:#333,stroke:#555,color:#777
