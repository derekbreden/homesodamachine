      P2["GPIO 2   GREEN status LED (ready)"]
      P12["GPIO 12  BLUE status LED (activity)"]
    end
  end

  %% ── Destinations ──
  S3["ESP32-S3-Touch-LCD-4.3B\n(config display + BLE,\n 800×480 touch, GT911;\n fixed front-face, angled up)"]

  FAUCET["ESP32-S3-Touch-LCD-1.47\n(faucet flavor display + touch,\n 172×320; TTL UART up the umbilical)"]

  I2C_DEVICES["I2C Devices:\n  DS3231 RTC  0x68\n  MCP23017    0x20  (8 valves on GPA; 4 reservoir reeds on GPB)\n  MCP23017    0x21  (4 valves + fan on GPA; 4 reservoir + 2 carbonator reeds on GPB)"]

  DRV["2× DRV8870 H-bridge\n(on-board; pumps A + B)"]

  PUMP1["Kamoer Pump A"]
  PUMP2["Kamoer Pump B"]

  FLOW["DIGITEN\nFlow Meter"]

  MOIST["Backflow drip-pan\nmoisture sensor (SIG-9)"]

  GAS["MQ-6 combustible-gas /\nR-600a leak sensor\n(rear cabinet floor)"]

  BUZZER["DIYables passive\npiezo buzzer\n(prime / refill cues)"]

  VALVE_CHAIN["MCP23017 0x20 (8 valve outputs + 4 reed inputs)\nMCP23017 0x21 (4 valves + fan outputs + 6 reed inputs)\n  ↓\n2× ULN2803A → 12 valves + condenser fan\n  ↑\n10 reed switches\n(8 reservoir + 2 carbonator;\nsee valve-control)"]

  RELAY["Teyleten 3.3V relay #1\n(compressor AC)"]
  COMP_AC["AC hermetic compressor\n  (Frigidaire EFIC117-SS donor,\n  120 VAC)"]

  DIA_RELAY["Teyleten 3.3V relay #2\n(diaphragm pump 12 V)"]
  DIA_PUMP["SeaFlo diaphragm pump\n  12 V, ~5 A peak\n  (carbonator refill)"]

  DS_PROBES["2× DS18B20 1-wire probes:\n  tank wall (cycle setpoint)\n  evap suction (freeze cutout)"]

  %% ── Connections ──
  P32 & P34 <-->|"Serial1 115200 baud\nvia ALMOCN RS485"| S3
  P33 & P35 <-->|"Serial2 UART\n(direct TTL,\n up the umbilical)"| FAUCET
  P21 & P22 <-->|"I2C"| I2C_DEVICES

  P18 & P17 -->|"Pump A"| DRV
  P16 & P4 -->|"Pump B"| DRV
  DRV ==>|"Channel A"| PUMP1
  DRV ==>|"Channel B"| PUMP2

  FLOW -->|"pulse interrupt"| P25

  P19 -->|"3.3V drive"| RELAY
  RELAY ==>|"switched 120VAC"| COMP_AC

  P23 -->|"3.3V drive"| DIA_RELAY
  DIA_RELAY ==>|"switched 12V"| DIA_PUMP

  DS_PROBES -->|"1-wire data"| P26

  I2C_DEVICES -->|"MCP23017"| VALVE_CHAIN
  MOIST -->|"INPUT"| P27
  P13 -->|"PWM tone"| BUZZER
  GAS -->|"AOUT (analog)"| P39
  GAS -->|"DOUT (trip)"| P36

