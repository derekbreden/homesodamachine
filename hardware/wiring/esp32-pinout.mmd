      P36["GPIO 36  Gas sensor DOUT (trip)"]
    end

    subgraph Refrigeration_Pins["Refrigeration"]
      P19["GPIO 19  Teyleten relay  (compressor AC)"]
      P26["GPIO 26  1-wire temp bus (DS18B20 + DS18S20)"]
    end

    subgraph Carbonator_Pins["Carbonator Water"]
      P2["GPIO 2   Diaphragm pump relay  (refill)"]
    end

    subgraph Alert_Pins["User Feedback"]
      P13["GPIO 13  Piezo buzzer (PWM tone)"]
    end

    subgraph LED_Pins["Status LEDs  (on-board, flanking the logo)"]
      P15["GPIO 15  RED status LED (fault)"]
      P12["GPIO 12  GREEN status LED (ready)"]
      P14["GPIO 14  BLUE status LED (activity)"]
    end
  end

  %% ── Destinations ──
  S3["ESP32-S3-Touch-LCD-4.3B\n(config display + BLE,\n 800×480 touch, GT911;\n fixed front-face, angled up)"]

  FAUCET["ESP32-S3-Touch-LCD-1.47\n(faucet flavor display + touch,\n 172×320; TTL UART up the umbilical)"]

  I2C_DEVICES["I2C Devices:\n  DS3231 RTC  0x68\n  MCP23017    0x20  (8 valves on GPA; 4 reservoir reeds on GPB)\n  MCP23017    0x21  (3 valves + fan on GPA; 4 reservoir + 2 carbonator reeds on GPB)\n  MPR121      0x5A  (off-board via J8 I2C header; cap-sense fluid-in-line)"]

  DRV["2× DRV8870 H-bridge\n(on-board; pumps A + B)"]

  PUMP1["Kamoer Pump A"]
  PUMP2["Kamoer Pump B"]

  FLOW["DIGITEN\nFlow Meter"]

  MOIST["Backflow drip-pan\nmoisture sensor (SIG-9)"]

  GAS["MQ-6 combustible-gas /\nR-600a leak sensor\n(rear cabinet floor)"]

  BUZZER["On-board buzzer U8\n(MLT-5020 magnetic transducer,\n prime / refill cues)"]

  VALVE_CHAIN["MCP23017 0x20 (8 valve outputs + 4 reed inputs)\nMCP23017 0x21 (3 valves + fan outputs + 6 reed inputs)\n  ↓\n2× TBD62083 → 11 valves + condenser fan\n(12 board channels; J2.OUT3 → V-K, OUT4 spare)\n  ↑\n10 reed switches\n(8 reservoir + 2 carbonator;\nsee valve-control)"]

  RELAY["Teyleten 3.3V relay #1\n(compressor AC)"]
  COMP_AC["AC hermetic compressor\n  (Frigidaire EFIC117-SS donor,\n  120 VAC)"]

  DIA_RELAY["Teyleten 3.3V relay #2\n(diaphragm pump 12 V)"]
  DIA_PUMP["SeaFlo diaphragm pump\n  12 V, ~5 A peak\n  (carbonator refill)"]

  DS_PROBES["2× 1-wire probes (told apart by family code):\n  DS18B20 0x28 tank wall (cycle setpoint)\n  DS18S20 0x10 evap suction (freeze cutout)"]

  %% ── Connections ──
  P32 & P34 <-->|"Serial1 115200 baud\nvia ALMOCN RS485"| S3
  P33 & P35 <-->|"Serial2 UART\n(direct TTL,\n up the umbilical)"| FAUCET
  P21 & P22 <-->|"I2C"| I2C_DEVICES

  P17 -->|"Pump A IN1"| DRV
  P4 -->|"Pump B IN1"| DRV
  DRV ==>|"Channel A"| PUMP1
  DRV ==>|"Channel B"| PUMP2

  FLOW -->|"pulse interrupt"| P25

  P19 -->|"3.3V drive"| RELAY
  RELAY ==>|"switched 120VAC"| COMP_AC

  P2 -->|"3.3V drive"| DIA_RELAY
  DIA_RELAY ==>|"switched 12V"| DIA_PUMP

  DS_PROBES -->|"1-wire data"| P26

  I2C_DEVICES -->|"MCP23017"| VALVE_CHAIN
  MOIST -->|"INPUT"| P27
  P23 -->|"switched VCC\n(powered only while sampling)"| MOIST
  P13 -->|"PWM tone"| BUZZER
  GAS -->|"AOUT (analog)"| P39
  GAS -->|"DOUT (trip)"| P36

