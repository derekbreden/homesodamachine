    "west_flank_and_prv_chase": {
      "trees": [
        "tree-1"
      ],
      "route": "Detach the exposed west-flank/rail-foot strips, rear identification-port lips, ASSE/tube-anchor interfaces and PRV cap/mouth contacts in the empty shell. Peel exposed strips outward and release internal branches through the open forebay. Approach the cap from the unobstructed central bay above its crown, release its interface, then break the sacrificial branch into pieces before extraction. The groove opens on the exterior flank.",
      "native_access_examples": [
        "empty central bay to open fore mouth",
        "west exposed flank",
        "forebay access above PRV crown",
        "lateral approach to detachable PRV crown support"
      ]
    },
    "east_flank_and_c14_field": {
      "trees": [
        "tree-2"
      ],
      "route": "Release the exposed east-flank rail-foot strip and the C14/adjacent rear-pocket interfaces through their rear openings and the empty forebay. Detach separate contacts and break the bed-rooted branch into removable portions before inserting the C14 inlet, cord, PSU, fasteners or loom.",
      "native_access_examples": [
        "east exposed flank",
        "C14 centre through tunnel and rear opening",
        "rear exposed C14 hood normal",
        "empty lower bay to open fore mouth"
      ]
    },
    "rear_keystone_and_identification_ports": {
      "trees": [
        "tree-13"
      ],
      "route": "Release the rear port lips and keystone pocket/catch contacts through the empty receptacle and open bay. The jack and its cable are absent. Detach contacts first and break the connected branch where needed; no complete tree is required to pass through a catch gap.",
      "native_access_examples": [
        "empty central bay to open fore mouth",
        "empty lower bay to open fore mouth"
      ]
    },
    "west_internal_pockets_and_anchors": {
      "trees": [
        "tree-4",
        "tree-6",
        "tree-7",
        "tree-10"
      ],
      "route": "Release each local ceiling/anchor or pocket interface from the unoccupied central bay before installing the cold core, tubes, valve trays or zip ties. The support is sacrificial: separate its contact strips and short legs into pieces, then extract them toward the open fore mouth or exposed west flank.",
      "native_access_examples": [
        "empty central bay to open fore mouth",
        "empty upper bay to open fore mouth",
        "west exposed flank"
      ]
    },
