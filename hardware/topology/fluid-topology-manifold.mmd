flowchart LR

  %% The complete flavor topology, drawn on the bodies the enclosure assembly places. Every box
  %% is one placed body — a valve, a pump, a junction fitting, the cold core, a panel bulkhead —
  %% and every edge is one connection, carrying what the machine makes it out of.

  %% Source of truth: `manifold-layout/enclosure_assembly.py` places the pack,
  %% `manifold-layout/_lines.py` authors every run BETWEEN placed bodies and `_routing.Run.length`
  %% measures it off the built centreline, and `manifold-layout/manifold_layout.py` makes the
  %% manifold's own interior. `_fluid_topology_sync.py` writes every label below and gates every
  %% edge against the built segment — an edge whose two ends are not that segment's two ends fails
  %% the gate.

  %% NO LENGTH IS DRAWN HERE. Segment by segment, the cut figures are what a bare run of
  %% `_fluid_topology_sync.py` prints: every segment with its length, its corners and how it is
  %% made, and the total under them. The aggregates below are `%%` markers, which the renderer
  %% never reaches.

  %% [26](SEGMENT_COUNT) flavor segments. [3](BUTT_COUNT) are collet butted to collet and carry
  %% no tube at all; [9](DRAWN_COUNT) are swept runs between placed bodies; the rest include
  %% [4](UPPER_LINK_COUNT) straight upper links, [8](LOWER_LINK_COUNT) straight lower links,
  %% printed TPU junctions/returns and the source pair's two quarter-and-step turns. Reported tube lengths total
  %% [2966.0 mm](FLUID_TOTAL) of 1/4" LLDPE over [61](FLUID_BENDS) corners, and the longest is
  %% [fluid-18](LONGEST_ID) at [438.2 mm](LONGEST_LEN). [0](OPEN_COUNT) are mouths with nothing
  %% on the far end of them: EVERY FLAVOR SEGMENT IN THIS CHART IS MADE. The stock total
  %% excludes machined pump stems and printed TPU passages. Mouth-to-mouth link lengths
  %% need their actual socket or fitting insertions for cut blanks. The funnel's gravity
  %% drain is drawn like the rest — the funnel is seated in the box rather than placed in the
  %% pack, so `fluid-4` is authored after the box exists, off the same frames.

  %% Colour is the circuit: white the shared source chain (fluid-1 … fluid-8), blue channel A
  %% (9 … 18), green channel B (19 … 28), grey the carbonator's own two runs through this bay.
  %% A dashed border is a fixed upper-deck body.

  %% Per-limb grouping without the endpoints is fluid-topology-limbs.mmd; the water and CO2 spine
  %% feeding the split, and everything the carbonator dispenses through, are
  %% fluid-topology-carbonator.mmd.

  %% =========================
  %% Feeds
  %% =========================
  %% The west lane's own column, every mouth on the ASSE chain's line. The split's supply side
  %% (rear bulkhead → ASSE 1022) is the carbonator chart's.
  subgraph Wall["Wall sequence — west lane"]
    Split["water-split<br/>1/4&quot; union tee"]
    FlowReg["flow-regulator"]
  end

  %% The funnel on the top-wall rim ledge behind the display facet, draining by gravity. The fold
  %% turns V-B's inlet to face the back of the machine. One node covers the funnel and the joint
  %% under it: a 1/4" stub stands in the +Z leg of a PP0308E union elbow, held in a printed
  %% cradle under the funnel frame, and the plug's sealing land pushes onto the stub's top. The
  %% elbow turns the fall aft on its own +Y leg. The funnel lifts off the stub for the
  %% dishwasher, and a thumb on that +Z collet frees the stub.
  Funnel["funnel<br/>+ PP0308E union elbow"]

  %% =========================
  %% The flavour manifold
  %% =========================
  %% Four limbs, two fixed decks. Each lane joins its valves through one junction:
  %% Y-A/Y-B are purchased tees; Y-C/Y-D/Y-F/Y-G are permanent printed TPU junctions.
  %% Each prepared pump stem enters its junction through the closed pump-bay wall.
  %% Straight upper links and fixed TPU returns connect the two valve rows.
  %% Channel A stands east of the mirror plane in the
  %% machine and channel B west, the pack posed face down on the refrigeration stratum's crown.
  subgraph Manifold["manifold pack — four limbs on two decks"]

    subgraph LA1["A1 — channel A, inner limb"]
      VA["V-A"]
      YA["Y-A"]
      VC["V-C"]
      YC["Y-C"]
      VE["V-E"]
    end

    subgraph LA2["A2 — channel A, outer limb"]
      VG["V-G"]
      YD["Y-D"]
      VF["V-F"]
    end

    subgraph LB1["B1 — channel B, inner limb"]
      VB["V-B"]
      YB["Y-B"]
      VD["V-D"]
      YF["Y-F"]
      VH["V-H"]
    end

    subgraph LB2["B2 — channel B, outer limb"]
      VJ["V-J"]
      YG["Y-G"]
      VI["V-I"]
    end

    PA["pump-a<br/>channel A"]
    PB["pump-b<br/>channel B"]
  end

  %% =========================
  %% Cold core, +Y wall of back-top, and what leaves the box
  %% =========================
  %% Four of the seven conduits in the core's top cap are this circuit's. Each reservoir is
  %% FILLED ABOVE ITS LIQUID, through a bore in its own cap, and DRAWN FROM ITS FLOOR, up a dip
  %% tube through a second bore in the same cap — so everything entering has to cross the cavity
  %% to leave, and the pair's two valves reach the two mouths directly.
  subgraph Core["foam-assembly — cold core"]
    ResAFill[("reservoir-A<br/>fill")]
    ResA[("reservoir-A<br/>draw")]
    ResBFill[("reservoir-B<br/>fill")]
    ResB[("reservoir-B<br/>draw")]
  end

  subgraph Panel["+Y wall of back-top"]
    BhA["bulkhead-flavor-a"]
    BhB["bulkhead-flavor-b"]
  end

  VK["vk-solenoid<br/>V-K &middot; carbonator fill"]
  ElbowS["pump-elbow-suction"]
  Faucet["Faucet — flavor tubes A &middot; B"]

  %% =========================
  %% Shared source chain — fluid-1 … fluid-8
  %% =========================
  %% Y-A and Y-B stand on their inner limbs' own axes, each between the source valve and the
  %% select it feeds, with their branches meeting face to face across the mirror plane. V-A and
  %% V-B come off the folded deck's plane on a quarter turn of R14, then step 28 mm further along
  %% the run and 14 mm across it, toward the cold core's crown.
  Split -->|"fluid-1"| FlowReg
  FlowReg -->|"fluid-2"| VA
  VA -->|"fluid-3"| YA
  Funnel -->|"fluid-4"| VB
  VB -->|"fluid-5"| YB
  YA <-->|"fluid-6<br/>butt"| YB
  YA -->|"fluid-7<br/>butt"| VC
  YB -->|"fluid-8<br/>butt"| VD

  %% =========================
  %% Channel A — fluid-9 … fluid-18
  %% =========================
  %% Y-C and Y-D are pump A's permanent TPU junctions. fluid-9 and fluid-17 each use
  %% two straight LLDPE links and one fixed printed TPU return. fluid-10 and fluid-13
  %% are straight upper links to the fore valves.
  VC -->|"fluid-9"| YC
  VE -->|"fluid-10"| YC
  YC -->|"fluid-11<br/>pump-dock"| PA
  PA -->|"fluid-12<br/>pump-dock"| YD
  YD -->|"fluid-13"| VF
  VF -->|"fluid-14"| ResAFill
  ResA -->|"fluid-16"| VE
  YD -->|"fluid-17"| VG
  VG -->|"fluid-18"| BhA

  %% =========================
  %% Channel B — fluid-19 … fluid-28
  %% =========================
  %% Channel B mirrors channel A about x = 0. Y-F and Y-G are pump B's permanent junctions;
  %% fluid-19 and fluid-27 use straight links and fixed TPU returns. V-I-O and V-H-I — the reservoir's fill gate and its draw
  %% gate — leave on their own axes off the lower deck, as channel A's V-F-O and V-E-I do.
  VD -->|"fluid-19"| YF
  VH -->|"fluid-20"| YF
  YF -->|"fluid-21<br/>pump-dock"| PB
  PB -->|"fluid-22<br/>pump-dock"| YG
  YG -->|"fluid-23"| VI
  VI -->|"fluid-24"| ResBFill
  ResB -->|"fluid-26"| VH
  YG -->|"fluid-27"| VJ
  VJ -->|"fluid-28"| BhB

  %% =========================
  %% V-K's own two runs — the carbonator circuit, through this bay
  %% =========================
  %% V-K gates the carbonator fill off the same split fluid-1 leaves. It stands on the cold core's
  %% crown, east of the G Ganen pump, and water-3 is the one run in the assembly that crosses the whole
  %% machine — the split is in the west lane, V-K is on the east, and its inlet faces forward.
  Split -->|"water-3"| VK
  %% V-K's outlet hands the pump its water on water-7, into the printed suction elbow on the
  %% pump's own barb. There is no `water-4`.
  VK -->|"water-7"| ElbowS

  %% =========================
  %% Beyond the box
  %% =========================
  %% The two flavor bulkheads are where this pack's runs END. The flavor tubes' exits are out
  %% on the faucet, down the umbilical, which no run here carries.
  BhA -.-> Faucet
  BhB -.-> Faucet

  %% Circuit colours. Mermaid numbers links by DECLARATION ORDER, so every index below is a count
  %% of the edges above it and not an authorship — `_fluid_topology_sync.py` writes each list off
  %% the parsed edge order and each edge's own route id, and the style after it is this chart's.
  %% The `(group:NAME)` in each comment is what tells the driver which line takes which list.
  %% Shared source chain (group:shared) — white.
  linkStyle 0,1,2,3,4,5,6,7 stroke:#ccc,stroke-width:2px
  %% Channel A (group:channel-a) — blue.
  linkStyle 8,9,10,11,12,13,14,15,16 stroke:#09f,stroke-width:2px
  %% Channel B (group:channel-b) — green.
  linkStyle 17,18,19,20,21,22,23,24,25 stroke:#22c55e,stroke-width:2px
  %% The carbonator circuit's two runs through this bay (group:carbonator) — grey.
  linkStyle 26,27 stroke:#777,stroke-width:2px
  %% Outside the pack (group:outside) — no run carries it.
  linkStyle 28,29 stroke:#555,stroke-width:1px

  %% Junction fittings. Y-A/Y-B are purchased PP0208E tees; their branches meet across
  %% the mirror plane. Y-C/Y-D/Y-F/Y-G are permanent printed TPU junctions at the
  %% prepared pump stems. Neither
  %% reservoir has one. fluid-topology.md "Junctions" carries where each port goes.
  classDef tee fill:#c2410c,stroke:#7c2d12,color:#ffffff,stroke-width:2px;
  class YA,YB,YC,YD,YF,YG tee;
  %% The fixed upper-deck bodies.
  classDef upper stroke-dasharray:4;
  class VA,VB,VC,VD,VG,VJ,YA,YB upper;
  %% Not the flavor manifold's — the carbonator's valve and pump elbow, and the pack's edge.
  classDef offcircuit fill:#3a3a3a,stroke:#666,color:#cccccc,stroke-width:1px;
  class VK,ElbowS,Faucet offcircuit;
