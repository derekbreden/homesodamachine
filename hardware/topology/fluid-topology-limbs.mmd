flowchart LR

  %% The valve manifold grouped by PHYSICAL CARRIER — the condensed view: valves and junctions
  %% only, sources, pumps, reservoirs and nozzles omitted. The complete chart, every endpoint
  %% present and every edge labelled with its route ID and what the machine makes it out of, is
  %% fluid-topology-manifold.mmd.

  %% Source of truth: the front half's placed pack. Every box below is one LIMB of
  %% `manifold_layout.LIMBS` and holds exactly the bodies that limb chains;
  %% `_fluid_topology_sync.py` gates it against that table.

  %% [4](LIMB_COUNT) limbs carry the [10](LIMB_VALVES) valves and the [6](TEE_COUNT) junction
  %% tees, over [2](PUMP_COUNT) pumps.

  %% A LIMB IS A LANE. Every valve is straight through and every junction's run takes two valve
  %% ports, so a limb is one line of valves and tees butted collet to collet, front to back, on
  %% one column of X. A tee dropped on a pump barb by its BRANCH puts its RUN across the head's
  %% face, so each pump hands out two of these lanes, 57 mm apart.

  %% THE PACK IS FOLDED IN TWO about the hinge the four barb tees' front collets stand on.
  %% [8](UPPER_COUNT) bodies ride up onto the second deck — drawn with a dashed border — and
  %% [8](LOWER_COUNT) stay on the first. The four connections crossing the hinge each become a
  %% 180° hairpin.

  %% Neither reservoir appears here and neither has a junction: each carries two mouths of its
  %% own, so each pair's two valves reach them directly.

  %% =========================
  %% Channel A — east of the mirror plane in the machine, over pump B
  %% =========================
  subgraph LA1["A1 — channel A, inner limb"]
    VA["V-A"]
    YA["Y-A"]
    VC["V-C"]
    YC["Y-C"]
    VE["V-E"]
  end

  subgraph LA2["A2 — channel A, outer limb"]
    VG["V-G"]
    YD["Y-D"]
    VF["V-F"]
  end

  %% =========================
  %% Channel B — west of it, over pump A
  %% =========================
  subgraph LB1["B1 — channel B, inner limb"]
    VB["V-B"]
    YB["Y-B"]
    VD["V-D"]
    YF["Y-F"]
    VH["V-H"]
  end

  subgraph LB2["B2 — channel B, outer limb"]
    VJ["V-J"]
    YG["Y-G"]
    VI["V-I"]
  end

  %% ---- Butted, along a limb's own lane ----
  %% Collet to collet, no tube between them. Blue.
  YA --> VC
  YB --> VD
  VE --> YC
  VH --> YF
  YD --> VF
  YG --> VI

  %% ---- Across the hinge ----
  %% The four 180° hairpins, each on its own limb's column: a quarter of R14, 31.4 mm of straight,
  %% and a quarter back. Orange.
  VC --> YC
  YD --> VG
  VD --> YF
  YG --> VJ

  %% ---- Out of the deck plane ----
  %% The source pair leaves its own limb's plane on a quarter turn of R14, then steps 28 mm
  %% further along the run and 14 mm across it, toward the cold core's crown. Grey.
  VA --> YA
  VB --> YB

  %% ---- Between limbs ----
  %% The crossbar, the one connection here that leaves its limb: Y-A's and Y-B's branches face
  %% each other across the mirror plane and meet on it. White.
  YA <--> YB

  %% ---- Styling ----
  %% All six junctions are PP0208E Tees — an in-line RUN and a BRANCH off it. What each port
  %% reaches is fluid-topology.md "Junctions".
  classDef tee fill:#c2410c,stroke:#7c2d12,color:#ffffff,stroke-width:2px;
  class YA,YB,YC,YD,YF,YG tee;
  %% The bodies forward of the hinge, which the fold carries up onto the second deck.
  classDef upper stroke-dasharray:4;
  class VA,VB,VC,VD,VG,VJ,YA,YB upper;
  linkStyle 0,1,2,3,4,5 stroke:#09f,stroke-width:2px
  linkStyle 6,7,8,9 stroke:#c2410c,stroke-width:2px
  linkStyle 10,11 stroke:#888,stroke-width:2px
  linkStyle 12 stroke:#ccc,stroke-width:2px
