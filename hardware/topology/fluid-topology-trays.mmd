flowchart LR

  %% Valve-manifold fluid topology grouped by physical tray. Each tray holds
  %% four Beduan solenoid valves; trays 1 and 2 also carry two Y-dividers each,
  %% tray 3 none. Blue links are on-tray valve-to-divider seats (effectively
  %% zero length). Gray links are real tube runs: tray-to-tray, tray-to-pump,
  %% and tray-to-enclosure (sources, bags, nozzles).

  %% ---- Remote components ----
  subgraph Sources["Sources"]
    Tap["Tap Water"]
    Hopper["Hopper"]
    BiBA["BiB A"]
    BiBB["BiB B"]
  end

  Reg["Flow Regulator"]

  subgraph Pumps["Pumps"]
    PA["Pump A"]
    PB["Pump B"]
  end

  subgraph Bags["Bags"]
    BagA[("Bag A")]
    BagB[("Bag B")]
  end

  subgraph Nozzles["Nozzles"]
    NozzleA["Nozzle A"]
    NozzleB["Nozzle B"]
  end

  %% ---- Trays ----
  subgraph Tray1["Tray 1 — Source Select"]
    VA["V-A"]
    VB["V-B"]
    YA{{"Y-A"}}
    YB{{"Y-B"}}
    VC["V-C"]
    VD["V-D"]
  end

  subgraph Tray2["Tray 2 — Bag Circuit"]
    VE["V-E"]
    VF["V-F"]
    YE{{"Y-E"}}
    VH["V-H"]
    VI["V-I"]
    YH{{"Y-H"}}
  end

  subgraph Tray3["Tray 3 — Gateways"]
    VG["V-G"]
    VJ["V-J"]
    VKA["V-K-A"]
    VKB["V-K-B"]
  end

  subgraph PumpCircuit["Pump circuit"]
    YKA{{"Y-KA"}}
    YC{{"Y-C"}}
    YD{{"Y-D"}}
    YKB{{"Y-KB"}}
    YF{{"Y-F"}}
    YG{{"Y-G"}}
  end

  %% ---- On-tray seats (blue, links 0-10) ----
  VA --> YA
  VB --> YA
  YA --> YB
  YB --> VC
  YB --> VD
  VF --> YE
  YE --> VE
  VI --> YH
  YH --> VH
  YKA --> YC
  YKB --> YF

  %% ---- Tube runs (gray, links 11-33) ----
  Tap --> Reg
  Reg --> VA
  Hopper --> VB
  BiBA --> VKA
  VKA --> YKA
  VC --> YKA
  VE --> YC
  YC --> PA
  PA --> YD
  YD --> VF
  YD --> VG
  VG --> NozzleA
  BiBB --> VKB
  VKB --> YKB
  VD --> YKB
  VH --> YF
  YF --> PB
  PB --> YG
  YG --> VI
  YG --> VJ
  VJ --> NozzleB
  YE <--> BagA
  YH <--> BagB

